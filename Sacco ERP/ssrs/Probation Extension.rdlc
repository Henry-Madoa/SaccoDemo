                  <TextRun>
                    <Value EvaluationMode="Auto">,</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value xml:space="preserve" EvaluationMode="Auto">
</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">RE: PROBATION EXTENSION</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>Underline</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">
This is to inform you that your probation period has been extended for another 3 months
with effect from </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!ProbationEndDate.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>MMMM d, yyyy</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto"> to </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!NewProbationEndDate.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>MMM d, yyyy</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">.
The reasons for the extension are as discussed and agreed between you and your line
manager </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!SupervisorName_AppraisalHeader.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto"> during your end of probation review on </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!AppraisalEndDate_AppraisalHeader.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>d</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">. In view of the
resolutions made in the probation review meeting with your line manager, you are hereby
required to improve on the following areas within the extended probation period:</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox3</rd:DefaultName>
            <Top>0.06944in</Top>
            <Left>0.22792in</Left>
            <Height>3.02084in</Height>
            <Width>7.70833in</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>36pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <Textbox Name="Textbox2">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">This extension is to provide you an opportunity to demonstrate the competence required.
Please refer to the job profile as provided and the performance targets set at the end of your
probation review meeting. During the extended probation period, you will focus on
achieving the targets set in this review meeting. These targets will form the key part of the
final probation review on your role as an Research Officer.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">
There will be an interim review of progress on </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!MonthAfterExtension.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>MMM d, yyyy</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto"> and
the end of the probation extension period review will be held on </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!Days7AfterExtension.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>MMMM d, yyyy</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto"> following which you may be confirmed to the post
depending on the outcome of the review. Should you fail to meet the agreed objectives
within the period set out above, your employment contract will be terminated in accordance
with the KEMRI-Wellcome Trust Programme procedures.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">
To confirm your acceptance of this probation extension letter, we would be grateful if you
would sign and return a copy of this letter to me, by </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=First(Fields!DayBeforeExtension.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <Format>MMMM d, yyyy</Format>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto"> If you have any queries regarding this extension, please do not hesitate to
contact me.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">
Yours sincerely,</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
