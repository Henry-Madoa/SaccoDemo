/// The staging table an existing member's detail changes go through before member.updateMember()
/// applies them on approval — mirrors member_application's shape (every editable member field,
/// plus its own approval workflow), except member_id is required from creation: an edit always
/// targets an existing member, never null-then-filled the way an application's is.
model member_edit_request {
  no                       String                    @id
  member_id                Int
  member_type              String                    @default("INDIVIDUAL")
  member_category_id       Int?
  title                    String?
  first_name               String
  middle_name              String?
  last_name                String
  national_id              String?
  kra_pin                  String?
  date_of_birth            String?
  gender                   String?
  marital_status           String?
  phone                    String?
  email                    String?
  postal_address           String?
  physical_address         String?
  county_id                Int?
  sub_county_id            Int?
  employer                 String?
  employment_status        String?
  staff_no                 String?
  gross_income             BigInt                    @default(0)
  other_deductions         BigInt                    @default(0)
  kyc_verified             Int                       @default(0)
  join_date                String?
  photo                    String?
  front_id_image           String?
  back_id_image            String?
  signature_image          String?
  fingerprint1_image       String?
  fingerprint2_image       String?
  notes                    String?
  group_name               String?
  registration_no          String?
  registration_date        String?
  contact_person_name      String?
  contact_person_phone     String?
  contact_person_email     String?
  member_count             Int?
  global_dimension_1_id    Int?
  global_dimension_2_id    Int?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                   String                    @default("Open")
  decision_reason          String?
  created_at               String?
  created_by               String?
  processed_at             String?
  processed_by             String?
  member                   member                    @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_category          member_category?          @relation(fields: [member_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  county                   county?                   @relation(fields: [county_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sub_county               sub_county?               @relation(fields: [sub_county_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_dimension_1_value global_dimension_1_value? @relation(fields: [global_dimension_1_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_dimension_2_value global_dimension_2_value? @relation(fields: [global_dimension_2_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_edit_attachment   member_edit_attachment[]
  member_edit_next_of_kin  member_edit_next_of_kin[]
  member_edit_nominee      member_edit_nominee[]
  member_edit_signatory    member_edit_signatory[]

  @@index([member_id], map: "ix_edit_member")
  @@index([status], map: "ix_edit_status")
  @@index([county_id], map: "ix_edit_county")
  @@index([sub_county_id], map: "ix_edit_sub_county")
  @@index([member_category_id], map: "ix_edit_category")
  @@index([global_dimension_1_id], map: "ix_edit_gd1")
  @@index([global_dimension_2_id], map: "ix_edit_gd2")
}

