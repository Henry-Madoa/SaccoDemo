/// A maker-checker request to deactivate an existing non-default savings account (the same
/// Open -> Pending Approval -> Approved -> Processed shape as account_opening_request) — see
/// lib/accountDeactivation.ts. Processing sets the target account's status to INACTIVE, which
/// lib/savings.ts's deposit()/withdraw() then refuse to post against.
model account_deactivation_request {
  no              String          @id
  account_id      Int
  reason          String?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status          String          @default("Open")
  decision_reason String?
  created_at      String?
  created_by      String?
  processed_at    String?
  processed_by    String?
  savings_account savings_account @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "ix_adr_account")
  @@index([status], map: "ix_adr_status")
}

/// A maker-checker request to reactivate an INACTIVE savings account (the same
/// Open -> Pending Approval -> Approved -> Processed shape as account_deactivation_request) —
/// see lib/accountActivation.ts. Processing sets the target account's status back to ACTIVE,
/// letting lib/savings.ts's deposit()/withdraw() post against it again. An optional
/// transaction_charge_id/debit_account_id pair lets the request carry its own reactivation-fee
/// Charge Code and which of the member's accounts it's debited from — chosen once at request
/// time rather than resolved automatically, so the charge and its funding source are fixed and
/// reviewable before anyone approves it.
model account_activation_request {
  no                    String              @id
  account_id            Int
  reason                String?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                String              @default("Open")
  decision_reason       String?
  created_at            String?
  created_by            String?
  processed_at          String?
  processed_by          String?
  transaction_charge_id Int?
  debit_account_id      Int?
  /// Set when the optional reactivation fee posts (mirrors member_charging.journal_id) — lets
  /// Find Entries trace the fee's journal back to this request, and vice versa.
  journal_id            Int?
  savings_account       savings_account     @relation("aar_activated_account", fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit_account         savings_account?    @relation("aar_debit_account", fields: [debit_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal               journal?            @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "ix_aar_account")
  @@index([status], map: "ix_aar_status")
}

/// Member Activation — a maker-checker request to reactivate a Dormant member, ported from the
/// AL reference's "Member Activation" card (Pag52204158 / Tab52204084). Posting
/// (lib/memberActivation.ts's processMemberActivationRequest()) flips the member back to
/// Active and reactivates every one of their own INACTIVE savings accounts — AL's own "unblock
/// every Vendor" loop in Cod52204007's ActivateMember(). Distinct from lib/memberStatusUpdate.ts's
/// automatic reactivation-on-deposit: this is the manual path for an officer who has a Dormant
/// member in front of them right now, mirroring AL's own "Pay From Account Type" choice between
/// the member paying cash at the till (pay_from_account_type = CASH, payment_reference is the
/// receipt/reference for it) or the fee being deducted from one of their own accounts
/// (MEMBER_ACCOUNT, debit_account_id). transaction_charge_id is freely chosen from any active
/// Transaction Charge (Admin Centre → Charges) — not auto-resolved by type, the same free pick
/// account_activation_request.transaction_charge_id already uses; null/unset keeps
/// reactivation free.
model member_activation_request {
  no                     String              @id
  member_id              Int
  reason                 String?
  /// AL's "Pay From Account Type": CASH | MEMBER_ACCOUNT.
  pay_from_account_type  String              @default("MEMBER_ACCOUNT")
  /// AL's "Payment Refrence" — only meaningful (and required) when paying by CASH.
  payment_reference      String?
  transaction_charge_id  Int?
  /// Only meaningful (and required) when pay_from_account_type = MEMBER_ACCOUNT.
  debit_account_id       Int?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                 String              @default("Open")
  decision_reason        String?
  created_at             String?
  created_by             String?
  processed_at           String?
  processed_by           String?
  /// Set when the optional reactivation fee posts — same Find Entries trace-back
  /// account_activation_request.journal_id already provides.
  journal_id             Int?
  member                 member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit_account          savings_account?    @relation(fields: [debit_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge     transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal                journal?            @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_mar_member")
  @@index([status], map: "ix_mar_status")
}

/// Member Re-admission — a maker-checker request to rejoin a member who previously exited
/// (member.status = WITHDRAWN). Deceased members are terminal and never eligible — see
/// lib/memberReadmission.ts. Same shape as member_activation_request, one step further: besides
/// flipping the member back to Active, processing also reopens/re-provisions the member's
/// Member Category default savings accounts, since Member Exit closed them.
model member_readmission_request {
  no                     String              @id
  member_id              Int
  reason                 String?
  /// AL's "Pay From Account Type": CASH | MEMBER_ACCOUNT.
  pay_from_account_type  String              @default("MEMBER_ACCOUNT")
  /// Only meaningful (and required) when paying by CASH.
  payment_reference      String?
  transaction_charge_id  Int?
  /// Only meaningful (and required) when pay_from_account_type = MEMBER_ACCOUNT.
  debit_account_id       Int?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                 String              @default("Open")
  decision_reason        String?
  created_at             String?
  created_by             String?
  processed_at           String?
  processed_by           String?
  /// Set when the optional re-admission fee posts.
  journal_id             Int?
  member                 member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit_account          savings_account?    @relation(fields: [debit_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge     transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal                journal?            @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_mrr_member")
  @@index([status], map: "ix_mrr_status")
}

/// Standing Order — ported from the AL reference's "Standing Order" card (Pag52204124 /
/// Tab52204076), a maker-checker instruction that, once Approved, runs itself unattended off a
/// Job Queue Entry (lib/standingOrders.ts's runStandingOrders()) rather than needing a separate
/// Process step — approval directly sets `running = true` (AL's own
/// Cod52204000.ApprovalMgmtCBSExt.al behaviour), and every subsequent transfer happens on its
/// own schedule from then on.
///
/// Narrowed from AL's fuller scope, matching how every other module in this port trims AL
/// features this schema/domain has no infrastructure for:
///   - standing_order_class is INTERNAL (to any of the destination member's own accounts),
///     EXTERNAL (an EFT-style payout through one of the SACCO's own bank/cashbook accounts), or
///     LOAN (through lib/loanService.ts's own repay(), which already allocates
///     interest-then-principal oldest-first — AL's separate Loan-Principal/Loan-Interest/Loan
///     Principal+Interest classes are collapsed into this one, since a bespoke principal-only or
///     interest-only posting exists nowhere else in this app). AL's own "Standing Order Types"
///     master (Tab52204075) — a free-text tag layered on top of this same class — is dropped
///     entirely: the class already identifies which of a member's orders a Transaction
///     Recovery should sweep, so a second tag would only ever duplicate it.
///   - AL's Period DateFormula is simplified to a plain month count (period_months), the same
///     kind of simplification organisation.member_exit_notice_days already applies elsewhere.
///   - run_type/run_from_day only matter for amount_type = FIXED (AL's own report only gates
///     Fixed postings by them; Sweep and Amount Based simply run every day there's money to
///     move). last_run_date is this port's idempotency guard against a Job Queue tick firing
///     more than once the same day — AL computes the equivalent from ledger entries live
///     ("Last Run Date" FlowField); storing it directly is simpler and matches
///     savings_account.last_activity's own precedent.
model standing_order {
  no                     String              @id
  member_id              Int
  account_id             Int
  /// INTERNAL | EXTERNAL | LOAN — see the model doc above for what AL's fuller STO Types enum
  /// collapses into.
  standing_order_class   String
  /// FIXED | SWEEP | AMOUNT_BASED
  amount_type            String              @default("FIXED")
  /// Meaningful only for FIXED.
  amount                 BigInt              @default(0)
  /// Meaningful only for AMOUNT_BASED — the balance threshold that must be reached before the
  /// (then full) available balance sweeps.
  amount_limit           BigInt              @default(0)
  /// INTERNAL only.
  destination_member_id  Int?
  destination_account_id Int?
  /// EXTERNAL only — one of the SACCO's own Bank/Cashbook accounts (bank_account) the payout is
  /// made through, the same Payment Channel concept lib/loanService.ts's disburse() already uses
  /// for a loan's own bank payout. AL's own EFT recipient sub-fields (Account Name/Bank
  /// Name/Branch/Swift Code) are dropped — posting_description carries the payment reference.
  destination_bank_account_id Int?
  /// LOAN only.
  destination_loan_id    Int?
  posting_description    String?
  /// SPECIFIC_DAY | END_MONTH | DAILY — meaningful only for amount_type = FIXED.
  run_type               String              @default("DAILY")
  /// SPECIFIC_DAY only; a day-of-month past the current month's last day runs on that last day
  /// instead (AL's own Next Run Date carry-forward, simplified to a live day-count check).
  run_from_day           Int?
  start_date             String
  till_further_notice    Boolean             @default(false)
  /// Null when till_further_notice — AL's CalcDate(Period, "Start Date") with Period simplified
  /// to a plain month count.
  period_months          Int?
  end_date               String?
  transaction_charge_id  Int?
  /// Excludes this order from runStandingOrders()'s own daily sweep — ported from AL's own
  /// "Salary Based" flag (Tab52204076 field 22) and Rep52204021's `if "Salary Based" then Skip`.
  /// A Salary Based order has no day-of-month schedule of its own (AL enforces this by blocking
  /// "Run From Day" once Salary Based is set); it only ever recovers through Checkoff & Salary
  /// Processing's own Calculate step, matched to a Transaction Recovery by standing_order_class —
  /// see lib/checkoffBatches.ts's calculateCheckoffRecoveries(). Without this exclusion the same
  /// order would be swept twice: once here, once by the ordinary daily job.
  salary_based           Boolean             @default(false)
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                 String              @default("Open")
  decision_reason        String?
  /// Set true the moment this is Approved (AL's own ApproveRecordApprovalRequest handling) —
  /// there is no separate Process step; the Job Queue picks up every running, non-terminated,
  /// non-frozen order from then on.
  running                Boolean             @default(false)
  /// An officer's own decision to stop the order for good — distinct from the system
  /// terminating it automatically (destination loan fully repaid, or past end_date).
  terminated             Boolean             @default(false)
  /// A temporary pause — auto-lifted once freeze_end_date passes (AL's own UpdateSTO behaviour),
  /// same automatic-unfreeze lib/standingOrders.ts's own run performs.
  freezed                Boolean             @default(false)
  freeze_end_date        String?
  last_run_date          String?
  created_at             String?
  created_by             String?
  member                 member              @relation("sto_owner", fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_member     member?             @relation("sto_destination", fields: [destination_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account        savings_account     @relation("sto_source_account", fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_account    savings_account?    @relation("sto_destination_account", fields: [destination_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_loan       loan?               @relation(fields: [destination_loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_bank_account bank_account?     @relation(fields: [destination_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge     transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkoff_calculation   checkoff_calculation[]

  @@index([member_id], map: "ix_sto_member")
  @@index([status], map: "ix_sto_status")
  @@index([running, terminated], map: "ix_sto_running")
}

/// An ad-hoc charge posted straight against a member's own withdrawable deposit account —
/// Table 52204206 / Pages 52204262 & 52204263 / Codeunit 52204019 in the source documentation.
/// Unlike every other request in this file, this one carries no approval workflow: whoever
/// creates it also posts it, so `status` only ever moves Open -> Posted (see
/// lib/memberCharging.ts). amount_charged is recalculated from transaction_charge_id/no_of_pages
/// right up to the moment of posting rather than trusted as a stored snapshot.
model member_charging {
  no                    String             @id
  description           String
  member_id             Int
  source_account_id     Int
  transaction_charge_id Int
  no_of_pages           Int?
  amount_charged        BigInt             @default(0)
  status                String             @default("Open")
  journal_id            Int?
  created_at            String?
  created_by            String?
  posted_at             String?
  posted_by             String?
  member                member             @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_account        savings_account    @relation(fields: [source_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal               journal?           @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_mc_member")
  @@index([status, created_at], map: "ix_mc_status")
}

model savings_product {
  id                                                        Int                               @id @default(autoincrement())
