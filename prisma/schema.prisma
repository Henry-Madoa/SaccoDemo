  savings_account                                           savings_account[]
  gl_account_savings_product_gl_control_idTogl_account      gl_account?                       @relation("savings_product_gl_control_idTogl_account", fields: [gl_control_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account_savings_product_gl_fee_income_idTogl_account   gl_account?                       @relation("savings_product_gl_fee_income_idTogl_account", fields: [gl_fee_income_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account_savings_product_gl_interest_exp_idTogl_account gl_account?                       @relation("savings_product_gl_interest_exp_idTogl_account", fields: [gl_interest_exp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_category_default_account                           member_category_default_account[]
  account_opening_request                                   account_opening_request[]
