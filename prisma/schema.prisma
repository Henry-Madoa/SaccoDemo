generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model accounting_period {
  id         Int    @id @default(autoincrement())
  code       String @unique
  start_date String
  end_date   String
  status     String @default("OPEN")
}

model app_user {
  id                         Int                          @id @default(autoincrement())
  username                   String                       @unique
  full_name                  String
  email                      String?
  phone                      String?
  password_hash              String
  role_id                    Int
  status                     String                       @default("ACTIVE")
  last_login_at              String?
  created_at                 String?
  /// BC-style "Work Date" (My Settings) — the date this user's own new documents suggest instead
  /// of the real system date, self-service via the My Settings page (lib/postingDates.ts's
  /// getWorkDate()). Must fall within this user's own effective Allow Posting range
  /// (approval_user_setup's own dates, falling back to organisation's) — validated on save, not
  /// enforced again on every read, so an admin narrowing the range after the fact doesn't need to
  /// silently invalidate an already-saved Work Date; the next save re-validates it.
  work_date                  String?
  role                       role                         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session                    session[]
  approval_user_setup        approval_user_setup?
  workflow_user_group_member workflow_user_group_member[]

  @@index([role_id], map: "ix_user_role")
}

model workflow {
  id                 Int                  @id @default(autoincrement())
  name               String
  document_type      String
  enabled            Int                  @default(1)
  created_at         String?
  created_by         String?
  workflow_condition workflow_condition[]
  workflow_step      workflow_step[]
  workflow_task      workflow_task[]

  @@index([document_type, enabled], map: "ix_workflow_doctype")
}

model workflow_condition {
  id          Int      @id @default(autoincrement())
  workflow_id Int
  field       String
  operator    String
  value       String
  value2      String?
  workflow    workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflow_id], map: "ix_condition_workflow")
}

model workflow_step {
  id                Int             @id @default(autoincrement())
  workflow_id       Int
  step_no           Int
  approver_type     String
  approver_user_id  Int?
  approver_group_id Int?
  notify_email      Int             @default(1)
  workflow          workflow        @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflow_task     workflow_task[]

  @@index([workflow_id, step_no], map: "ix_step_workflow")
}

/// Registers the one table backing a document type's workflow conditions (admin-managed
/// under Admin Centre → Workflow Management → Table Relations), and via
/// workflow_table_relation_field, which of that table's columns are enabled as condition
/// fields — one table relation has many fields.
model workflow_table_relation {
  id            Int                             @id @default(autoincrement())
  document_type String                          @unique
  table_name    String
  created_at    String?
  created_by    String?
  field         workflow_table_relation_field[]
}

model workflow_table_relation_field {
  id                Int                     @id @default(autoincrement())
  table_relation_id Int
  field_name        String
  table_relation    workflow_table_relation @relation(fields: [table_relation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([table_relation_id, field_name], map: "ux_table_relation_field")
}

model workflow_user_group {
  id            Int                          @id @default(autoincrement())
  name          String                       @unique
  status        String                       @default("ACTIVE")
  member        workflow_user_group_member[]
  workflow_task workflow_task[]
}

/// Members approve in ascending sequence order — any member who approves at the
/// current (lowest pending) sequence clears that level for the rest of that level
/// and moves the task on to the next one. Members sharing a sequence are alternates.
model workflow_user_group_member {
  id       Int                 @id @default(autoincrement())
  group_id Int
  user_id  Int
  sequence Int                 @default(1)
  group    workflow_user_group @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     app_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, user_id], map: "ux_group_member")
}

/// BC-style "User Setup": who approves this user's requests, their substitute, whether they're a
/// fallback "approval administrator" when no approver resolves, and (allow_posting_* below) this
/// user's own override of organisation.allow_posting_from/to — blank falls back to the org's
/// global range, exactly as BC's own User Setup falls back to General Ledger Setup.
model approval_user_setup {
  id                        Int      @id @default(autoincrement())
  user_id                   Int      @unique
  approver_id               Int?
  substitute_id             Int?
  is_approval_administrator Int      @default(0)
  can_reverse_journal       Int      @default(0)
  /// This user's own Allow Posting From/To dates — null leaves the corresponding organisation
  /// column in force for this user. See lib/postingDates.ts's getEffectivePostingRange().
  allow_posting_from        String?
  allow_posting_to          String?
  /// Time-of-day refinement on the two boundary dates only (BC has no stock equivalent — this
  /// port's own addition): a posting dated exactly allow_posting_from must be at/after this time
  /// of day (real wall-clock, not the posting date's own — dates carry no time in this schema);
  /// dated exactly allow_posting_to, at/before it. Dates strictly between the two boundaries are
  /// never time-restricted. Null on either side leaves that boundary's whole day unrestricted.
  allow_posting_from_time   String?
  allow_posting_to_time     String?
  user                      app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_approval_administrator], map: "ix_approval_admin")
}

/// One pending or decided step of an in-flight workflow, against any document type.
/// workflow_id/workflow_step_id are null for a "legacy" task — no admin-defined
/// workflow matched, so it's decided by the document's static permission check
/// (e.g. LOAN:APPROVE) rather than a specific assignee, exactly as before this
/// module existed.
model workflow_task {
  id                   Int                  @id @default(autoincrement())
  workflow_id          Int?
  workflow_step_id     Int?
  step_no              Int
  document_type        String
  entity_id            String
  assigned_to_user_id  Int?
  assigned_to_group_id Int?
  /// Which sequence level of a group-assigned task is currently pending — null for
  /// a task assigned to a single user. Advances within this same row as members at
  /// each level approve, before the task's step itself ever moves on.
  current_sequence     Int?
  /// Set when the current approver hands this task off: delegated_by loses
  /// eligibility, delegated_to gains it, until the task is decided or (for a
  /// sequenced group) its level advances and the delegation is cleared.
  delegated_by_user_id Int?
  delegated_to_user_id Int?
  status               String               @default("PENDING")
  requested_by         String
  requested_at         String
  decided_by           String?
  decided_at           String?
  comment              String?
  amount               BigInt               @default(0)
  payload              String?
  workflow             workflow?            @relation(fields: [workflow_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workflow_step        workflow_step?       @relation(fields: [workflow_step_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workflow_user_group  workflow_user_group? @relation(fields: [assigned_to_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "ix_task_status")
  @@index([document_type, entity_id], map: "ix_task_document")
  @@index([assigned_to_user_id], map: "ix_task_assignee")
}

model notification {
  id         Int     @id @default(autoincrement())
  user_id    Int
  type       String
  title      String
  body       String?
  link       String?
  is_read    Int     @default(0)
  created_at String

  @@index([user_id, is_read], map: "ix_notification_user")
}

model attachment {
  id            Int     @id @default(autoincrement())
  entity        String
  entity_id     Int
  public_id     String  @unique
  url           String
  filename      String
  resource_type String  @default("image")
  format        String?
  bytes         Int     @default(0)
  category      String?
  uploaded_at   String
  uploaded_by   String

  @@index([entity, entity_id, id(sort: Desc)], map: "ix_attachment_entity")
}

model audit_log {
  id        Int     @id @default(autoincrement())
  at        String
  user_id   Int?
  username  String?
  action    String
  entity    String?
  entity_id String?
  detail    String?
  ip        String?

  @@index([at(sort: Desc)], map: "ix_audit_at")
}

/// Which tables get field-level change tracking — mirrors Business Central's Change Log
/// Setup: nothing is logged for a table until an admin opts it into Insertion/Modification/
/// Deletion here. Rows are seeded by migration, not created at runtime.
model change_log_setup {
  table_name       String @id
  table_caption    String
  log_insertion    Int    @default(0)
  log_modification Int    @default(0)
  log_deletion     Int    @default(0)
}

/// One row per changed field, written only for a table/change-type enabled in
/// change_log_setup — mirrors Business Central's Change Log Entries.
model change_log_entry {
  id            Int     @id @default(autoincrement())
  table_name    String
  table_caption String
  record_id     String
  field_name    String
  old_value     String?
  new_value     String?
  type          String
  changed_at    String
  user_id       Int?
  username      String

  @@index([table_name, record_id], map: "ix_change_log_entry_record")
  @@index([changed_at(sort: Desc)], map: "ix_change_log_entry_at")
}

model county {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique
  status                 String                   @default("ACTIVE")
  sub_county             sub_county[]
  member                 member[]
  member_application     member_application[]
  member_edit_request    member_edit_request[]
  collateral_application collateral_application[]
  collateral_register    collateral_register[]
}

model global_dimension_1_value {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique
  name                String                @unique
  status              String                @default("ACTIVE")
  member              member[]
  member_application  member_application[]
  member_edit_request member_edit_request[]
  journal             journal[]
  journal_line        journal_line[]
}

model global_dimension_2_value {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique
  name                String                @unique
  status              String                @default("ACTIVE")
  member              member[]
  member_application  member_application[]
  member_edit_request member_edit_request[]
  journal             journal[]
  journal_line        journal_line[]
}

model sub_county {
  id                  Int                   @id @default(autoincrement())
  county_id           Int
  name                String
  status              String                @default("ACTIVE")
  county              county                @relation(fields: [county_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member              member[]
  member_application  member_application[]
  member_edit_request member_edit_request[]

  @@unique([county_id, name])
  @@index([county_id], map: "ix_sub_county_county")
}

model gl_account {
  id                                                             Int                        @id @default(autoincrement())
  code                                                           String                     @unique
  name                                                           String
  type                                                           String
  parent_code                                                    String?
  is_postable                                                    Int                        @default(1)
  account_type                                                   String                     @default("POSTING")
  totaling                                                       String?
  balance                                                        BigInt                     @default(0)
  status                                                         String                     @default("ACTIVE")
  /// Blocks this account from a manual G/L journal line — it's a subledger control account
  /// (Bank, savings liability, loan receivable) and must be posted through its subledger
  /// instead. Enforced only at the manual-journal entry point; postJournal() itself still
  /// posts to these accounts freely for savings/loan/charge postings. See lib/gl.ts.
  no_direct_posting                                              Int                        @default(0)
  journal_line                                                   journal_line[]
  bank_account                                                   bank_account?
  loan_product_loan_product_gl_interest_income_idTogl_account    loan_product[]             @relation("loan_product_gl_interest_income_idTogl_account")
  loan_product_loan_product_gl_penalty_income_idTogl_account     loan_product[]             @relation("loan_product_gl_penalty_income_idTogl_account")
  loan_product_loan_product_gl_receivable_idTogl_account         loan_product[]             @relation("loan_product_gl_receivable_idTogl_account")
  savings_product_savings_product_gl_control_idTogl_account      savings_product[]          @relation("savings_product_gl_control_idTogl_account")
  savings_product_savings_product_gl_fee_income_idTogl_account   savings_product[]          @relation("savings_product_gl_fee_income_idTogl_account")
  savings_product_savings_product_gl_interest_exp_idTogl_account savings_product[]          @relation("savings_product_gl_interest_exp_idTogl_account")
  member_category                                                member_category[]
  transaction_charge_setup                                       transaction_charge_setup[]
  loan_product_charge                                            loan_product_charge[]
  member_fixed_deposit_type_interest_expense                     member_fixed_deposit_type[] @relation("mfdt_interest_expense")
  member_fixed_deposit_type_interest_payable                     member_fixed_deposit_type[] @relation("mfdt_interest_payable")
  member_fixed_deposit_type_withholding_tax                      member_fixed_deposit_type[] @relation("mfdt_withholding_tax")
  cheque_type                                                    cheque_type[]
  cheque_deposit                                                 cheque_deposit[]           @relation("cd_clearing_gl_account")
}

model charge {
  id                       Int                        @id @default(autoincrement())
  code                     String                     @unique
  description              String
  status                   String                     @default("ACTIVE")
  transaction_charge_setup transaction_charge_setup[]
  loan_product_charge      loan_product_charge[]
}

/**
 * One row per chargeable transaction type — Business Central's "Transaction Charge" parent,
 * keyed by transaction_type since this app resolves the applicable charge by the document
 * being processed rather than by an admin-picked code.
 */
model transaction_charge {
  id                         Int                          @id @default(autoincrement())
  code                       String                       @unique
  description                String
  /// Not unique: more than one named Transaction Charge can be configured for the same type
  /// (e.g. a standard vs. a waived reactivation fee), and the triggering document picks one
  /// explicitly — see account_activation_request.transaction_charge_id.
  transaction_type           String
  status                     String                       @default("ACTIVE")
  transaction_charge_setup   transaction_charge_setup[]
  account_activation_request account_activation_request[]
  member_activation_request  member_activation_request[]
  member_readmission_request member_readmission_request[]
  standing_order             standing_order[]
  member_charging            member_charging[]
  member_exit                member_exit[]
  transaction_recovery       transaction_recovery[]
  checkoff_batch             checkoff_batch[]
  organisation               organisation[]
  teller_transaction         teller_transaction[]
  inter_account_transfer     inter_account_transfer[]
  cheque_type_clearing       cheque_type[]              @relation("ct_clearing_charge")
  cheque_type_bouncing       cheque_type[]              @relation("ct_bouncing_charge")
  cheque_type_express        cheque_type[]              @relation("ct_express_charge")
  bankers_cheque             bankers_cheque[]
  cheque_deposit_clearing    cheque_deposit[]           @relation("cd_clearing_charge")

  @@index([transaction_type], map: "ix_tc_type")
}

/**
 * A component charge within a Transaction Charge — Business Central's "Transaction Charges
 * Setup" line: which charge, where it posts, how it's calculated, and in what order.
 */
model transaction_charge_setup {
  id                      Int                        @id @default(autoincrement())
  transaction_charge_id   Int
  charge_id               Int
  gl_account_id           Int
  calculation_type        String                     @default("SCHEME")
  source_setup_id         Int?
  priority                Int                        @default(1)
  status                  String                     @default("ACTIVE")
  transaction_charge      transaction_charge         @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  charge                  charge                     @relation(fields: [charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account              gl_account                 @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_setup            transaction_charge_setup?  @relation("SetupSource", fields: [source_setup_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dependent_setups        transaction_charge_setup[] @relation("SetupSource")
  transaction_calc_scheme transaction_calc_scheme[]

  @@index([transaction_charge_id], map: "ix_tcs_charge")
}

/**
 * Amount-band rate rule for one component — Business Central's "Transaction Calc. Scheme".
 * A component may have several bands (tiered by Lower/Upper Limit against the base amount
 * the calculation is run against); the admin UI ships one band per component for now, but the
 * engine and schema support more.
 */
model transaction_calc_scheme {
  id                          Int                      @id @default(autoincrement())
  transaction_charge_setup_id Int
  lower_limit                 BigInt                   @default(0)
  upper_limit                 BigInt?
  rate_type                   String                   @default("FLAT")
  flat_amount                 BigInt                   @default(0)
  percentage_rate             Float                    @default(0)
  upper_charge_limit          BigInt                   @default(0)
  lower_charge_limit          BigInt                   @default(0)
  transaction_charge_setup    transaction_charge_setup @relation(fields: [transaction_charge_setup_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([transaction_charge_setup_id], map: "ix_tcalc_setup")
}

model member_category {
  id                              Int                               @id @default(autoincrement())
  code                            String                            @unique
  description                     String
  category_type                   String
  registration_fee                BigInt                            @default(0)
  registration_fee_account_id     Int?
  status                          String                            @default("ACTIVE")
  gl_account                      gl_account?                       @relation(fields: [registration_fee_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_category_default_account member_category_default_account[]
  member                          member[]
  member_application              member_application[]
  member_edit_request             member_edit_request[]
}

model member_category_default_account {
  id                 Int             @id @default(autoincrement())
  member_category_id Int
  savings_product_id Int
  description        String
  member_category    member_category @relation(fields: [member_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_product    savings_product @relation(fields: [savings_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([member_category_id, savings_product_id])
  @@index([savings_product_id], map: "ix_mcda_product")
}

model journal {
  id                                            Int                          @id @default(autoincrement())
  journal_no                                    String                       @unique
  value_date                                    String
  posted_at                                     String
  source_module                                 String
  event_type                                    String
  description                                   String?
  reference                                     String?
  member_id                                     Int?
  amount                                        BigInt
  posted_by                                     String?
  reverses_id                                   Int?
  reversed_by_id                                Int?
  idempotency_key                               String?                      @unique
  global_dimension_1_id                         Int?
  global_dimension_2_id                         Int?
  member                                        member?                      @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_dimension_1_value                      global_dimension_1_value?    @relation(fields: [global_dimension_1_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_dimension_2_value                      global_dimension_2_value?    @relation(fields: [global_dimension_2_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_journal_reversed_by_idTojournal       journal?                     @relation("journal_reversed_by_idTojournal", fields: [reversed_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_journal_journal_reversed_by_idTojournal journal[]                    @relation("journal_reversed_by_idTojournal")
  journal_journal_reverses_idTojournal          journal?                     @relation("journal_reverses_idTojournal", fields: [reverses_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_journal_journal_reverses_idTojournal    journal[]                    @relation("journal_reverses_idTojournal")
  journal_line                                  journal_line[]
  txn                                           txn[]
  member_charging                               member_charging[]
  account_activation_request                    account_activation_request[]
  member_activation_request                     member_activation_request[]
  member_readmission_request                    member_readmission_request[]
  bank_account_ledger_entry                     bank_account_ledger_entry[]
  fosa_transaction                              fosa_transaction[]
  teller_transaction                            teller_transaction[]

  @@index([value_date], map: "ix_journal_date")
  @@index([global_dimension_1_id], map: "ix_journal_gd1")
  @@index([global_dimension_2_id], map: "ix_journal_gd2")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_line {
  id                        Int                         @id @default(autoincrement())
  journal_id                Int
  line_no                   Int
  gl_account_id             Int
  debit                     BigInt                      @default(0)
  credit                    BigInt                      @default(0)
  narration                 String?
  global_dimension_1_id     Int?
  global_dimension_2_id     Int?
  gl_account                gl_account                  @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal                   journal                     @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_dimension_1_value  global_dimension_1_value?   @relation(fields: [global_dimension_1_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_dimension_2_value  global_dimension_2_value?   @relation(fields: [global_dimension_2_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_account_ledger_entry bank_account_ledger_entry[]

  @@index([gl_account_id], map: "ix_jl_account")
  @@index([journal_id], map: "ix_jl_journal")
  @@index([global_dimension_1_id], map: "ix_jl_gd1")
  @@index([global_dimension_2_id], map: "ix_jl_gd2")
}

/// The Bank Account subledger master (Business Central's Bank Account card) — one row per
/// real-world bank/cash/mobile-money account the SACCO holds, each mapped 1:1 to its own
/// no-direct-posting G/L control account. Seeded to match the existing CHANNEL_GL map in
/// lib/savings.ts (Cash Till/Bank/M-Pesa/Check-off) so every channel a teller already posts
/// through has a matching reconcilable bank account from day one.
model bank_account {
  id                        Int                         @id @default(autoincrement())
  code                      String                      @unique
  name                      String
  gl_account_id             Int                         @unique
  bank_name                 String?
  account_no                String?
  balance                   BigInt                      @default(0)
  status                    String                      @default("ACTIVE")
  /// FOSA tellering role — 'MAIN' (the SACCO's external bank), 'TREASURY' (the branch vault),
  /// 'TILL' (a teller's own cash drawer), or 'OTHER' (M-Pesa/check-off clearing and the generic
  /// teller cash account the Savings screen posts through). Drives which accounts each
  /// fosa_transaction document type may move cash between — see lib/cashManagement.ts.
  account_type              String                      @default("OTHER")
  gl_account                gl_account                  @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_account_ledger_entry bank_account_ledger_entry[]
  bank_reconciliation       bank_reconciliation[]
  txn                       txn[]
  standing_order            standing_order[]
  teller_setup                 teller_setup[]
  teller_transaction           teller_transaction[]
  fosa_transaction_source      fosa_transaction[]          @relation("ft_source")
  fosa_transaction_destination fosa_transaction[]          @relation("ft_destination")
}

/// One posted entry against a bank account's G/L control account — populated automatically by
/// postJournal() (lib/accounting.ts) for every journal line that hits a bank_account's
/// gl_account_id, whatever module posted it. This is what makes reconciliation complete: it
/// covers manual G/L journals against the account too, not just savings/loan postings that
/// happen to carry a txn row.
model bank_account_ledger_entry {
  id                     Int                  @id @default(autoincrement())
  bank_account_id        Int
  journal_id             Int
  journal_line_id        Int
  posting_date           String
  description            String?
  amount                 BigInt
  running_balance        BigInt
  reconciled             Int                  @default(0)
  bank_reconciliation_id Int?
  created_at             String?
  bank_account           bank_account         @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal                journal              @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal_line           journal_line         @relation(fields: [journal_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_reconciliation    bank_reconciliation? @relation(fields: [bank_reconciliation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bank_account_id], map: "ix_bale_account")
  @@index([journal_id], map: "ix_bale_journal")
  @@index([bank_reconciliation_id], map: "ix_bale_reconciliation")
}

/// One reconciliation session against a bank account's statement — Business Central's Bank
/// Account Reconciliation. Holds the header (statement date/balance); the entries it clears
/// are the bank_account_ledger_entry rows whose bank_reconciliation_id points back at it.
model bank_reconciliation {
  id                        Int                         @id @default(autoincrement())
  bank_account_id           Int
  statement_date            String
  statement_balance         BigInt
  status                    String                      @default("OPEN")
  created_by                String?
  created_at                String?
  completed_by              String?
  completed_at              String?
  bank_account              bank_account                @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_account_ledger_entry bank_account_ledger_entry[]

  @@index([bank_account_id], map: "ix_brec_account")
}

model loan {
  id                     Int               @id @default(autoincrement())
  loan_no                String            @unique
  member_id              Int
  product_id             Int
  principal              BigInt
  interest_rate          Float
  interest_method        String
  term_months            Int
  purpose                String?
  /// SASRA Sectorial Lending classification — AL Tab52204014 fields 68 / 70 / 72.
  sector_code            String?
  sub_sector_code        String?
  sub_subsector_code     String?
  status                 String            @default("PENDING")
  applied_date           String?
  approved_date          String?
  approved_by            String?
  rejected_reason        String?
  disbursed_date         String?
  first_due_date         String?
  installment            BigInt            @default(0)
  total_interest         BigInt            @default(0)
  fees_charged           BigInt            @default(0)
  principal_balance      BigInt            @default(0)
  interest_balance       BigInt            @default(0)
  penalty_balance        BigInt            @default(0)
  principal_paid         BigInt            @default(0)
  interest_paid          BigInt            @default(0)
  arrears_amount         BigInt            @default(0)
  days_in_arrears        Int               @default(0)
  classification         String            @default("PERFORMING")
  disburse_to_account_id Int?
  /// 'DIRECT' | 'CHECKOFF' — AL's Recovery Mode. A CHECKOFF loan is picked up by
  /// lib/checkoffBatches.ts's batch lines instead of relying on counter/own-initiative repayment.
  recovery_mode          String            @default("DIRECT")
  created_by             String?
  version                Int               @default(0)
  savings_account        savings_account?  @relation(fields: [disburse_to_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member                 member            @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan_product           loan_product      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan_guarantor         loan_guarantor[]
  loan_schedule          loan_schedule[]
  txn                    txn[]
  loan_collateral        loan_collateral[]
  loan_appraisal         loan_appraisal[]
  loan_calculator        loan_calculator[]
  loan_salary_appraisal_line loan_salary_appraisal_line[]
  loan_guarantor_change  loan_guarantor_change[]
  member_exit_line       member_exit_line[]
  loan_fd_lien           loan_fd_lien[]
  standing_order         standing_order[]
  cheque_instruction     cheque_instruction[]
  economic_sector        economic_sector?  @relation(fields: [sector_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_loan_member")
  @@index([recovery_mode], map: "ix_loan_recovery_mode")
  @@index([product_id], map: "ix_loan_product")
  @@index([status], map: "ix_loan_status")
  @@index([sector_code], map: "ix_loan_sector")
}

/// AL Tab52204077 "Economic Sectors" — the top level of the SASRA Sectorial Lending
/// classification (Agriculture, Manufacturing, Trade, …).
model economic_sector {
  code                  String                  @id
  name                  String
  created_at            String?
  created_by            String?
  economic_subsector    economic_subsector[]
  economic_subsubsector economic_subsubsector[]
  loan                  loan[]
}

/// AL Tab52204078 "Economic Subsectors".
model economic_subsector {
  id              Int             @id @default(autoincrement())
  sector_code     String
  code            String
  name            String
  economic_sector economic_sector @relation(fields: [sector_code], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sector_code, code])
}

/// AL Tab52204079 "Economic Sub-subsector".
model economic_subsubsector {
  id              Int             @id @default(autoincrement())
  sector_code     String
  subsector_code  String
  code            String
  description     String
  economic_sector economic_sector @relation(fields: [sector_code], references: [code], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sector_code, subsector_code, code], map: "economic_subsubsector_key")
}

model loan_guarantor {
  id        Int    @id @default(autoincrement())
  loan_id   Int
  member_id Int
  amount    BigInt @default(0)
  status    String @default("COMMITTED")
  loan      loan   @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member    member @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([loan_id, member_id])
  @@index([member_id], map: "ix_lg_member")
}

model loan_product {
  id                                                        Int                   @id @default(autoincrement())
  code                                                      String                @unique
  name                                                      String
  interest_rate                                             Float                 @default(12)
  interest_method                                           String                @default("REDUCING")
  max_term_months                                           Int                   @default(48)
  min_amount                                                BigInt                @default(0)
  max_amount                                                BigInt                @default(500000000)
  deposit_multiplier                                        Float                 @default(3)
  min_membership_months                                     Int                   @default(6)
  penalty_rate                                              Float                 @default(1)
  guarantors_required                                       Int                   @default(2)
  max_dsr_pct                                               Float                 @default(66.7)
  salary_based                                              Int                   @default(0)
  /// Months of processed SALARY-type checkoff batches required before a salary_based product's
  /// affordability can be assessed at all — below AL's "Min. Salary Count".
  min_salary_count                                          Int                   @default(1)
  /// 'AVERAGE_NET' | 'LOWEST_NET' — how a salary_based product reduces a member's processed
  /// salary history to the single base figure max_dsr_pct is checked against.
  salary_appraisal_type                                     String                @default("AVERAGE_NET")
  repayment_cutoff_date                                     Int                   @default(0)
  gl_receivable_id                                          Int?
  gl_interest_income_id                                     Int?
  gl_penalty_income_id                                      Int?
  status                                                    String                @default("ACTIVE")
  loan                                                      loan[]
  loan_calculator                                           loan_calculator[]
  gl_account_loan_product_gl_interest_income_idTogl_account gl_account?           @relation("loan_product_gl_interest_income_idTogl_account", fields: [gl_interest_income_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account_loan_product_gl_penalty_income_idTogl_account  gl_account?           @relation("loan_product_gl_penalty_income_idTogl_account", fields: [gl_penalty_income_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account_loan_product_gl_receivable_idTogl_account      gl_account?           @relation("loan_product_gl_receivable_idTogl_account", fields: [gl_receivable_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan_product_charge                                       loan_product_charge[]
}

/**
 * One charge a loan product levies — Loan Products' own "Loan Product Charges" line, structured
 * like Transaction Charges Setup (lib/charges.ts) but scoped to a product instead of a
 * transaction type, and without Percentage-of-Charge chaining: every line's base is always the
 * loan principal. `charge_id` is the same reusable Charges master (Admin Centre -> Charges ->
 * Charge Codes) Transaction Charges draws from, so a code like "PROCESSING FEE" means the same
 * thing everywhere it's used. Calculation Method is either a flat Percentage of the principal,
 * or Calculate from Scheme — an amount-banded tariff table (loan_product_charge_scheme below),
 * matched against the principal the same way a Transaction Calc. Scheme is. `prorate` scales the
 * resolved amount by termMonths/12 — for a charge priced as an annual rate but billed once at
 * disbursement (e.g. insurance) rather than levied in full regardless of a shorter term.
 */
model loan_product_charge {
  id                         Int                          @id @default(autoincrement())
  product_id                 Int
  charge_id                  Int
  gl_account_id              Int
  calculation_type           String                       @default("PERCENTAGE")
  percentage_rate            Float                        @default(0)
  prorate                    Boolean                      @default(false)
  priority                   Int                          @default(1)
  status                     String                       @default("ACTIVE")
  loan_product               loan_product                 @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  charge                     charge                       @relation(fields: [charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account                 gl_account                   @relation(fields: [gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan_product_charge_scheme loan_product_charge_scheme[]

  @@index([product_id], map: "ix_lpc_product")
}

/**
 * Amount-band rate rule for one Loan Product Charge line whose Calculation Method is Calculate
 * from Scheme — the loan-product-scoped twin of transaction_calc_scheme, banded against the
 * loan principal rather than a transaction's base amount. Same shape: upper_limit null means
 * unbounded, and the *_charge_limit fields only apply to a Percentage band.
 */
model loan_product_charge_scheme {
  id                     Int                 @id @default(autoincrement())
  loan_product_charge_id Int
  lower_limit            BigInt              @default(0)
  upper_limit            BigInt?
  rate_type              String              @default("FLAT")
  flat_amount            BigInt              @default(0)
  percentage_rate        Float               @default(0)
  upper_charge_limit     BigInt              @default(0)
  lower_charge_limit     BigInt              @default(0)
  loan_product_charge    loan_product_charge @relation(fields: [loan_product_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([loan_product_charge_id], map: "ix_lpcs_charge")
}

model loan_schedule {
  id              Int    @id @default(autoincrement())
  loan_id         Int
  installment_no  Int
  due_date        String
  opening_balance BigInt @default(0)
  principal_due   BigInt @default(0)
  interest_due    BigInt @default(0)
  principal_paid  BigInt @default(0)
  interest_paid   BigInt @default(0)
  status          String @default("DUE")
  loan            loan   @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([loan_id, installment_no], map: "ix_ls_loan")
}

/**
 * A dated, immutable credit-appraisal run against a loan — captured on submit and re-run any
 * time before disbursement to revalidate eligibility (section 8's disburseLoan precondition).
 * Never updated in place: staff re-appraise, they don't edit history, so the loan's decision
 * trail always shows exactly what was known and decided at each point in time.
 */
model loan_appraisal {
  id                    Int                     @id @default(autoincrement())
  loan_id               Int
  decision              String
  score                 Int
  installment           BigInt                  @default(0)
  deposits              BigInt                  @default(0)
  exposure              BigInt                  @default(0)
  max_by_multiplier     BigInt                  @default(0)
  dsr                   Float                   @default(0)
  monthly_obligations   BigInt                  @default(0)
  appraised_by          String?
  appraised_at          String?
  loan                  loan                    @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan_appraisal_factor loan_appraisal_factor[]

  @@index([loan_id], map: "ix_lap_loan")
}

/**
 * One factor's pass/fail result within a loan_appraisal run — the explainable breakdown
 * shown on the Appraisal tab and the printed Appraisal Report.
 */
model loan_appraisal_factor {
  id             Int            @id @default(autoincrement())
  appraisal_id   Int
  seq            Int            @default(0)
  code           String
  label          String
  pass           Boolean
  detail         String?
  loan_appraisal loan_appraisal @relation(fields: [appraisal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appraisal_id], map: "ix_lapf_appraisal")
}

/**
 * A predefined payslip line item (Table 52204034 "Loanees Payroll Codes") — the master list of
 * earnings and deductions a "salary based" loan product's Salary Appraisal section is built
 * from. `special_type` flags the one earning line ("BASIC_SALARY") the one-third affordability
 * cap is computed against; every other line is a plain, freely-added code.
 */
model salary_appraisal_parameter {
  id           Int    @id @default(autoincrement())
  code         String @unique
  name         String
  type         String // EARNING | DEDUCTION
  special_type String @default("NONE") // NONE | BASIC_SALARY
  sort_order   Int    @default(0)
  status       String @default("ACTIVE")

  loan_salary_appraisal_line loan_salary_appraisal_line[]
}

/**
 * One salary-appraisal line on a loan (Table 52204035 "Loanees Payroll Transactions") — a
 * snapshot of a salary_appraisal_parameter's code/name/type at the time the loan was seeded,
 * plus the amount the loan officer typed in to mimic the member's payslip. `parameter_id` is
 * null and `editable` false for the auto-derived rows representing the member's other disbursed
 * loans' installments (special_type LOAN_DEDUCTION) — those are regenerated on every view, not
 * hand-entered.
 */
model loan_salary_appraisal_line {
  id           Int     @id @default(autoincrement())
  loan_id      Int
  parameter_id Int?
  code         String
  name         String
  type         String // EARNING | DEDUCTION
  special_type String  @default("NONE") // NONE | BASIC_SALARY | LOAN_DEDUCTION
  amount       BigInt  @default(0)
  editable     Boolean @default(true)

  loan                        loan                         @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salary_appraisal_parameter  salary_appraisal_parameter?  @relation(fields: [parameter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([loan_id, code])
  @@index([loan_id], map: "ix_lsal_loan")
}

/**
 * A dated, immutable what-if loan calculation (Table 52204036 "Loan Calculator") — a loan
 * officer picks a member and product, types a principal and term, and this snapshots the
 * member's deposit-multiplier headroom (loanableDeposits x product.deposit_multiplier, less
 * existing exposure) alongside a full repayment schedule under whichever Rate Type they want
 * to compare, without capturing an actual loan application. Never edited or recalculated in
 * place — like loan_appraisal, a new run is simply a new row — so a member's calculation
 * history stays an honest record of what was quoted and when.
 */
model loan_calculator {
  id                        Int                   @id @default(autoincrement())
  calc_no                   String                @unique
  member_id                 Int
  product_id                Int
  principal                 BigInt                @default(0)
  interest_rate             Float                 @default(0)
  rate_type                 String                @default("AMORTISED")
  term_months               Int
  repayment_start_date      String
  current_deposits          BigInt                @default(0)
  deposit_multiplier_amount BigInt                @default(0)
  outstanding_loans         BigInt                @default(0)
  deposit_appraisal         BigInt                @default(0)
  installment               BigInt                @default(0)
  total_interest            BigInt                @default(0)
  status                    String                @default("Open")
  converted_loan_id         Int?
  converted_at              String?
  converted_by              String?
  created_at                String?
  created_by                String?
  member                    member                @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan_product              loan_product          @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan                      loan?                 @relation(fields: [converted_loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan_calculator_line      loan_calculator_line[]

  @@index([member_id], map: "ix_lc_member")
  @@index([product_id], map: "ix_lc_product")
  @@index([status], map: "ix_lc_status")
}

/** One projected installment of a loan_calculator run (Table 52204037 "Loan Calculator Lines"). */
model loan_calculator_line {
  id                  Int             @id @default(autoincrement())
  calculator_id       Int
  installment_no      Int
  due_date            String
  opening_balance     BigInt          @default(0)
  principal_due       BigInt          @default(0)
  interest_due        BigInt          @default(0)
  installment_amount  BigInt          @default(0)
  closing_balance     BigInt          @default(0)
  loan_calculator     loan_calculator @relation(fields: [calculator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([calculator_id, installment_no], map: "ix_lcl_calculator")
}

model member_next_of_kin {
