  discount_date_calculation     String  @default("")
  discount_pct                  Float   @default(0)
  calc_pmt_disc_on_credit_memos Int     @default(0)
  status                        String  @default("ACTIVE")
  created_at                    String?
  created_by                    String?
}

/// Business Central Table 289 "Payment Method".
model payment_method {
  id               Int     @id @default(autoincrement())
  code             String  @unique
  description      String
  /// 'None' | 'G/L Account' | 'Bank Account'
  bal_account_type String  @default("None")
  bal_account_no   String?
  status           String  @default("ACTIVE")
  created_at       String?
  created_by       String?
}

/// Business Central Table 293 "Reminder Terms".
model reminder_terms {
  id                  Int              @id @default(autoincrement())
