/// A maker-checker request to deactivate an existing non-default savings account (the same
/// Open -> Pending Approval -> Approved -> Processed shape as account_opening_request) — see
/// lib/accountDeactivation.ts. Processing sets the target account's status to INACTIVE, which
/// lib/savings.ts's deposit()/withdraw() then refuse to post against.
model account_deactivation_request {
  no              String          @id
  account_id      Int
  reason          String?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status          String          @default("Open")
  decision_reason String?
  created_at      String?
  created_by      String?
  processed_at    String?
  processed_by    String?
  savings_account savings_account @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "ix_adr_account")
  @@index([status], map: "ix_adr_status")
}

/// A maker-checker request to reactivate an INACTIVE savings account (the same
/// Open -> Pending Approval -> Approved -> Processed shape as account_deactivation_request) —
/// see lib/accountActivation.ts. Processing sets the target account's status back to ACTIVE,
/// letting lib/savings.ts's deposit()/withdraw() post against it again. An optional
/// transaction_charge_id/debit_account_id pair lets the request carry its own reactivation-fee
/// Charge Code and which of the member's accounts it's debited from — chosen once at request
/// time rather than resolved automatically, so the charge and its funding source are fixed and
/// reviewable before anyone approves it.
model account_activation_request {
  no                    String              @id
  account_id            Int
  reason                String?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                String              @default("Open")
  decision_reason       String?
  created_at            String?
  created_by            String?
  processed_at          String?
  processed_by          String?
  transaction_charge_id Int?
  debit_account_id      Int?
  /// Set when the optional reactivation fee posts (mirrors member_charging.journal_id) — lets
  /// Find Entries trace the fee's journal back to this request, and vice versa.
  journal_id            Int?
  savings_account       savings_account     @relation("aar_activated_account", fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit_account         savings_account?    @relation("aar_debit_account", fields: [debit_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal               journal?            @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "ix_aar_account")
  @@index([status], map: "ix_aar_status")
}

/// Member Activation — a maker-checker request to reactivate a Dormant member, ported from the
/// AL reference's "Member Activation" card (Pag52204158 / Tab52204084). Posting
/// (lib/memberActivation.ts's processMemberActivationRequest()) flips the member back to
/// Active and reactivates every one of their own INACTIVE savings accounts — AL's own "unblock
/// every Vendor" loop in Cod52204007's ActivateMember(). Distinct from lib/memberStatusUpdate.ts's
/// automatic reactivation-on-deposit: this is the manual path for an officer who has a Dormant
/// member in front of them right now, mirroring AL's own "Pay From Account Type" choice between
/// the member paying cash at the till (pay_from_account_type = CASH, payment_reference is the
/// receipt/reference for it) or the fee being deducted from one of their own accounts
/// (MEMBER_ACCOUNT, debit_account_id). transaction_charge_id is freely chosen from any active
/// Transaction Charge (Admin Centre → Charges) — not auto-resolved by type, the same free pick
/// account_activation_request.transaction_charge_id already uses; null/unset keeps
/// reactivation free.
model member_activation_request {
  no                    String              @id
  member_id             Int
  reason                String?
  /// AL's "Pay From Account Type": CASH | MEMBER_ACCOUNT.
  pay_from_account_type String              @default("MEMBER_ACCOUNT")
  /// AL's "Payment Refrence" — only meaningful (and required) when paying by CASH.
  payment_reference     String?
  transaction_charge_id Int?
  /// Only meaningful (and required) when pay_from_account_type = MEMBER_ACCOUNT.
  debit_account_id      Int?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                String              @default("Open")
  decision_reason       String?
  created_at            String?
  created_by            String?
  processed_at          String?
  processed_by          String?
  /// Set when the optional reactivation fee posts — same Find Entries trace-back
  /// account_activation_request.journal_id already provides.
  journal_id            Int?
  member                member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit_account         savings_account?    @relation(fields: [debit_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal               journal?            @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_mar_member")
  @@index([status], map: "ix_mar_status")
}

/// Member Re-admission — a maker-checker request to rejoin a member who previously exited
/// (member.status = WITHDRAWN). Deceased members are terminal and never eligible — see
/// lib/memberReadmission.ts. Same shape as member_activation_request, one step further: besides
/// flipping the member back to Active, processing also reopens/re-provisions the member's
/// Member Category default savings accounts, since Member Exit closed them.
model member_readmission_request {
  no                    String              @id
  member_id             Int
  reason                String?
  /// AL's "Pay From Account Type": CASH | MEMBER_ACCOUNT.
  pay_from_account_type String              @default("MEMBER_ACCOUNT")
  /// Only meaningful (and required) when paying by CASH.
  payment_reference     String?
  transaction_charge_id Int?
  /// Only meaningful (and required) when pay_from_account_type = MEMBER_ACCOUNT.
  debit_account_id      Int?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                String              @default("Open")
  decision_reason       String?
  created_at            String?
  created_by            String?
  processed_at          String?
  processed_by          String?
  /// Set when the optional re-admission fee posts.
  journal_id            Int?
  member                member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit_account         savings_account?    @relation(fields: [debit_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal               journal?            @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_mrr_member")
  @@index([status], map: "ix_mrr_status")
}

/// Standing Order — ported from the AL reference's "Standing Order" card (Pag52204124 /
/// Tab52204076), a maker-checker instruction that, once Approved, runs itself unattended off a
/// Job Queue Entry (lib/standingOrders.ts's runStandingOrders()) rather than needing a separate
/// Process step — approval directly sets `running = true` (AL's own
/// Cod52204000.ApprovalMgmtCBSExt.al behaviour), and every subsequent transfer happens on its
/// own schedule from then on.
///
/// Narrowed from AL's fuller scope, matching how every other module in this port trims AL
/// features this schema/domain has no infrastructure for:
///   - standing_order_class is INTERNAL (to any of the destination member's own accounts),
///     EXTERNAL (an EFT-style payout through one of the SACCO's own bank/cashbook accounts), or
///     LOAN (through lib/loanService.ts's own repay(), which already allocates
///     interest-then-principal oldest-first — AL's separate Loan-Principal/Loan-Interest/Loan
///     Principal+Interest classes are collapsed into this one, since a bespoke principal-only or
///     interest-only posting exists nowhere else in this app). AL's own "Standing Order Types"
///     master (Tab52204075) — a free-text tag layered on top of this same class — is dropped
///     entirely: the class already identifies which of a member's orders a Transaction
///     Recovery should sweep, so a second tag would only ever duplicate it.
///   - AL's Period DateFormula is simplified to a plain month count (period_months), the same
///     kind of simplification organisation.member_exit_notice_days already applies elsewhere.
///   - run_type/run_from_day only matter for amount_type = FIXED (AL's own report only gates
///     Fixed postings by them; Sweep and Amount Based simply run every day there's money to
///     move). last_run_date is this port's idempotency guard against a Job Queue tick firing
///     more than once the same day — AL computes the equivalent from ledger entries live
///     ("Last Run Date" FlowField); storing it directly is simpler and matches
///     savings_account.last_activity's own precedent.
model standing_order {
  no                          String                 @id
  member_id                   Int
  account_id                  Int
  /// INTERNAL | EXTERNAL | LOAN — see the model doc above for what AL's fuller STO Types enum
  /// collapses into.
  standing_order_class        String
  /// FIXED | SWEEP | AMOUNT_BASED
  amount_type                 String                 @default("FIXED")
  /// Meaningful only for FIXED.
  amount                      BigInt                 @default(0)
  /// Meaningful only for AMOUNT_BASED — the balance threshold that must be reached before the
  /// (then full) available balance sweeps.
  amount_limit                BigInt                 @default(0)
  /// INTERNAL only.
  destination_member_id       Int?
  destination_account_id      Int?
  /// EXTERNAL only — one of the SACCO's own Bank/Cashbook accounts (bank_account) the payout is
  /// made through, the same Payment Channel concept lib/loanService.ts's disburse() already uses
  /// for a loan's own bank payout. AL's own EFT recipient sub-fields (Account Name/Bank
  /// Name/Branch/Swift Code) are dropped — posting_description carries the payment reference.
  destination_bank_account_id Int?
  /// LOAN only.
  destination_loan_id         Int?
  posting_description         String?
  /// SPECIFIC_DAY | END_MONTH | DAILY — meaningful only for amount_type = FIXED.
  run_type                    String                 @default("DAILY")
  /// SPECIFIC_DAY only; a day-of-month past the current month's last day runs on that last day
  /// instead (AL's own Next Run Date carry-forward, simplified to a live day-count check).
  run_from_day                Int?
  start_date                  String
  till_further_notice         Boolean                @default(false)
  /// Null when till_further_notice — AL's CalcDate(Period, "Start Date") with Period simplified
  /// to a plain month count.
  period_months               Int?
  end_date                    String?
  transaction_charge_id       Int?
  /// Excludes this order from runStandingOrders()'s own daily sweep — ported from AL's own
  /// "Salary Based" flag (Tab52204076 field 22) and Rep52204021's `if "Salary Based" then Skip`.
  /// A Salary Based order has no day-of-month schedule of its own (AL enforces this by blocking
  /// "Run From Day" once Salary Based is set); it only ever recovers through Checkoff & Salary
  /// Processing's own Calculate step, matched to a Transaction Recovery by standing_order_class —
  /// see lib/checkoffBatches.ts's calculateCheckoffRecoveries(). Without this exclusion the same
  /// order would be swept twice: once here, once by the ordinary daily job.
  salary_based                Boolean                @default(false)
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                      String                 @default("Open")
  decision_reason             String?
  /// Set true the moment this is Approved (AL's own ApproveRecordApprovalRequest handling) —
  /// there is no separate Process step; the Job Queue picks up every running, non-terminated,
  /// non-frozen order from then on.
  running                     Boolean                @default(false)
  /// An officer's own decision to stop the order for good — distinct from the system
  /// terminating it automatically (destination loan fully repaid, or past end_date).
  terminated                  Boolean                @default(false)
  /// A temporary pause — auto-lifted once freeze_end_date passes (AL's own UpdateSTO behaviour),
  /// same automatic-unfreeze lib/standingOrders.ts's own run performs.
  freezed                     Boolean                @default(false)
  freeze_end_date             String?
  last_run_date               String?
  created_at                  String?
  created_by                  String?
  member                      member                 @relation("sto_owner", fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_member          member?                @relation("sto_destination", fields: [destination_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account             savings_account        @relation("sto_source_account", fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_account         savings_account?       @relation("sto_destination_account", fields: [destination_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_loan            loan?                  @relation(fields: [destination_loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_bank_account    bank_account?          @relation(fields: [destination_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge          transaction_charge?    @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkoff_calculation        checkoff_calculation[]

  @@index([member_id], map: "ix_sto_member")
  @@index([status], map: "ix_sto_status")
  @@index([running, terminated], map: "ix_sto_running")
}

/// An ad-hoc charge posted straight against a member's own withdrawable deposit account —
/// Table 52204206 / Pages 52204262 & 52204263 / Codeunit 52204019 in the source documentation.
/// Unlike every other request in this file, this one carries no approval workflow: whoever
/// creates it also posts it, so `status` only ever moves Open -> Posted (see
/// lib/memberCharging.ts). amount_charged is recalculated from transaction_charge_id/no_of_pages
/// right up to the moment of posting rather than trusted as a stored snapshot.
model member_charging {
  no                    String             @id
  description           String
  member_id             Int
  source_account_id     Int
  transaction_charge_id Int
  no_of_pages           Int?
  amount_charged        BigInt             @default(0)
  status                String             @default("Open")
  journal_id            Int?
  created_at            String?
  created_by            String?
  posted_at             String?
  posted_by             String?
  member                member             @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_account        savings_account    @relation(fields: [source_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal               journal?           @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_mc_member")
  @@index([status, created_at], map: "ix_mc_status")
}

model savings_product {
  id                                                        Int                               @id @default(autoincrement())
  code                                                      String                            @unique
  name                                                      String
  category                                                  String                            @default("SAVINGS")
  min_balance                                               BigInt                            @default(0)
  min_opening                                               BigInt                            @default(0)
  interest_rate                                             Float                             @default(0)
  allow_withdrawal                                          Int                               @default(1)
  /// AL "Cash Transfer Allowed" (Vendor / Sacco Products) — whether an account on this product may
  /// be the SOURCE of an inter-account transfer. Backfilled to allow_withdrawal on migration.
  allow_transfer                                            Int                               @default(1)
  withdrawal_fee                                            BigInt                            @default(0)
  is_loanable_base                                          Int                               @default(0)
  is_business_account                                       Int                               @default(0)
  withdrawal_notice_days                                    Int                               @default(0)
  gl_control_id                                             Int?
  gl_interest_exp_id                                        Int?
  gl_fee_income_id                                          Int?
  status                                                    String                            @default("ACTIVE")
  savings_account                                           savings_account[]
  gl_account_savings_product_gl_control_idTogl_account      gl_account?                       @relation("savings_product_gl_control_idTogl_account", fields: [gl_control_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account_savings_product_gl_fee_income_idTogl_account   gl_account?                       @relation("savings_product_gl_fee_income_idTogl_account", fields: [gl_fee_income_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gl_account_savings_product_gl_interest_exp_idTogl_account gl_account?                       @relation("savings_product_gl_interest_exp_idTogl_account", fields: [gl_interest_exp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_category_default_account                           member_category_default_account[]
  account_opening_request                                   account_opening_request[]
  member_fixed_deposit_type                                 member_fixed_deposit_type[]
  transaction_recovery                                      transaction_recovery[]
}

/// A member fixed-deposit product: interest rate bounds, calc method (Flat vs Reducing Balance,
/// ported from AL's Cod52204010.CreateFixedDepositSchedule), the savings_product new FD accounts
/// open under, and the GL accounts interest accrual/withholding tax post to. Admin-managed master
/// data, no workflow — mirrors lib/collateralTypes.ts's shape.
model member_fixed_deposit_type {
  id                       Int                    @id @default(autoincrement())
  code                     String                 @unique
  description              String
  min_interest_rate        Float                  @default(0)
  max_interest_rate        Float                  @default(0)
  interest_calc_type       String                 @default("FLAT") // 'FLAT' | 'REDUCING'
  linked_product_id        Int
  interest_expense_gl_id   Int
  interest_payable_gl_id   Int
  withholding_tax_rate     Float                  @default(0)
  withholding_tax_gl_id    Int?
  status                   String                 @default("ACTIVE")
  savings_product          savings_product        @relation(fields: [linked_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interest_expense_account gl_account             @relation("mfdt_interest_expense", fields: [interest_expense_gl_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interest_payable_account gl_account             @relation("mfdt_interest_payable", fields: [interest_payable_gl_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  withholding_tax_account  gl_account?            @relation("mfdt_withholding_tax", fields: [withholding_tax_gl_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_fixed_deposit     member_fixed_deposit[]
}

/// The maker-checker document for a member's term deposit — Open -> Pending Approval -> Approved,
/// then its own richer post-approval lifecycle (Active -> Matured/Terminated) tracked directly in
/// `status` rather than the shared 4-state DocumentStatus, same reason `loan.status` isn't either.
/// See lib/fixedDeposits.ts. Ported from AL's Tab52204018 "Member Fixed Deposits".
model member_fixed_deposit {
  no                                String                              @id
  member_id                         Int
  fd_type_id                        Int
  rate                              Float
  maturity_instructions             String                              @default("LIQUIDATE") // ROLLOVER_PRINCIPAL | ROLLOVER_NET | LIQUIDATE
  amount                            BigInt
  source_account_id                 Int
  /// The FD's own dedicated savings_account (product = the type's linked_product_id), created on
  /// activation — holds exactly `amount` until maturity/termination pays it out.
  fd_account_id                     Int?
  start_date                        String
  term_months                       Int
  end_date                          String
  status                            String                              @default("Open") // Open | Pending Approval | Approved | Active | Matured | Terminated
  decision_reason                   String?
  /// Roll-over chain — set on both sides when maturity creates a successor FD.
  rolled_from_no                    String?
  rolled_to_no                      String?
  created_at                        String?
  created_by                        String?
  activated_at                      String?
  activated_by                      String?
  processed_at                      String?
  processed_by                      String?
  member                            member                              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_fixed_deposit_type         member_fixed_deposit_type           @relation(fields: [fd_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_account                    savings_account                     @relation("mfd_source_account", fields: [source_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fd_account                        savings_account?                    @relation("mfd_fd_account", fields: [fd_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_fixed_deposit_schedule     member_fixed_deposit_schedule[]
  loan_fd_lien                      loan_fd_lien[]
  loan_guarantor_change_replacement loan_guarantor_change_replacement[]

  @@index([member_id], map: "ix_mfd_member")
  @@index([status], map: "ix_mfd_status")
}

/// Monthly interest accrual line for a Member Fixed Deposit — ported from AL's Tab52204019
/// "Member Fixed Deposit Schedule". `transferred` flips once its GL accrual journal has posted
/// (lib/fixedDeposits.ts's accrueFixedDepositInterest); maturity sums every row regardless.
model member_fixed_deposit_schedule {
  id                   Int                  @id @default(autoincrement())
  fd_no                String
  posting_date         String
  description          String?
  amount               BigInt               @default(0)
  transferred          Boolean              @default(false)
  member_fixed_deposit member_fixed_deposit @relation(fields: [fd_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([fd_no], map: "ix_mfds_fd_no")
}

/// A Fixed Deposit pledged as security for a loan — the FD-as-collateral sibling of
/// loan_collateral (which covers physical collateral_register items; loan_guarantor covers
/// guarantor security). See lib/loanFdSecurity.ts. Attach/detach only while the loan is OPEN,
/// same point loan_collateral/loan_guarantor are fixed.
model loan_fd_lien {
  id                   Int                  @id @default(autoincrement())
  loan_id              Int
  fd_no                String
  guarantee            BigInt
  status               String               @default("ACTIVE") // ACTIVE | RELEASED
  created_at           String?
  created_by           String?
  loan                 loan                 @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_fixed_deposit member_fixed_deposit @relation(fields: [fd_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@unique([loan_id, fd_no])
  @@index([fd_no], map: "ix_lfl_fd_no")
}

model sequence {
  name    String @id
  prefix  String @default("")
  next_no Int    @default(1)
  width   Int    @default(6)
}

/// Business Central No. Series (Table 308). One per numbered document; `nextSequence()` / the
/// legacy `sequence` table are superseded once a series exists for a code.
model no_series {
  code        String            @id
  description String            @default("")
  /// "Default Nos." — the series is offered automatically on a new document.
  default_nos Int               @default(1)
  /// "Manual Nos." — a user may also type a number by hand.
  manual_nos  Int               @default(0)
  /// "Date Order" — numbers must be assigned in non-decreasing document-date order.
  date_order  Int               @default(0)
  lines       no_series_line[]
  setups      no_series_setup[]
}

/// Business Central No. Series Line (Table 309): a date-effective number range.
model no_series_line {
  id              Int       @id @default(autoincrement())
  series_code     String
  line_no         Int       @default(10000)
  starting_date   String?
  starting_no     String
  ending_no       String?
  last_no_used    String?
  last_date_used  String?
  warning_no      String?
  increment_by_no Int       @default(1)
  open            Int       @default(1)
  allow_gaps      Int       @default(0)
  series          no_series @relation(fields: [series_code], references: [code], onDelete: Cascade)

  @@index([series_code])
}

/// Which No. Series each numbered document draws from — BC keeps these as the "…Nos." fields on
/// the setup cards; consolidated here onto the Admin Centre → No. Series card.
model no_series_setup {
  document_code String     @id
  label         String
  category      String     @default("General")
  sort          Int        @default(0)
  series_code   String?
  series        no_series? @relation(fields: [series_code], references: [code])

  @@index([series_code])
}

model session {
  token      String   @id
  user_id    Int
  created_at String?
  expires_at String?
  app_user   app_user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model theme {
  id         Int     @id
  preset     String? @default("custom")
  tokens     String
  updated_at String?
  updated_by String?
}

model txn {
  id                 Int              @id @default(autoincrement())
  txn_ref            String           @unique
  value_date         String
  created_at         String
  module             String
  txn_type           String
  member_id          Int?
  savings_account_id Int?
  loan_id            Int?
  amount             BigInt
  running_balance    BigInt?
  channel            String?          @default("TELLER")
  description        String?
  journal_id         Int?
  created_by         String?
  status             String           @default("POSTED")
  reversal_of        Int?
  /// The specific Bank/Cashbook account this loan disbursement or repayment moved through —
  /// only set for a manual external payout/receipt (Pay Mode below); null when funded from/to a
  /// member's own savings account, where no bank account is touched at all. See
  /// lib/loanService.ts's disburse()/repay().
  bank_account_id    Int?
  /// 'CASH' | 'MPESA' | 'BANK' | 'EFT' | 'CHEQUE' — how a manual external loan disbursement/
  /// repayment was actually paid, alongside (not instead of) which bank_account received/paid it.
  pay_mode           String?
  /// Pay Mode = CHEQUE only.
  cheque_no          String?
  /// Pay Mode = CHEQUE only.
  cheque_date        String?
  /// Pay Mode = MPESA | BANK | EFT only — the M-Pesa code / bank transfer or EFT reference.
  reference_no       String?
  journal            journal?         @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan               loan?            @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member             member?          @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  txn                txn?             @relation("txnTotxn", fields: [reversal_of], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_txn          txn[]            @relation("txnTotxn")
  savings_account    savings_account? @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bank_account       bank_account?    @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bank_account_id], map: "ix_txn_bank_account")
  @@index([value_date], map: "ix_txn_date")
  @@index([loan_id, id], map: "ix_txn_loan")
  @@index([member_id, id(sort: Desc)], map: "ix_txn_member")
  @@index([savings_account_id, id], map: "ix_txn_sa")
}

/// An admin-defined CSV export/import package (Admin Centre → Data Management), modeled on
/// Business Central's Configuration Packages: which table, and via config_package_field, which
/// of that table's columns are included — one package has many fields.
model config_package {
  id         Int                    @id @default(autoincrement())
  code       String                 @unique
  name       String
  table_name String
  key_field  String?
  created_at String?
  created_by String?
  field      config_package_field[]
}

model config_package_field {
  id         Int            @id @default(autoincrement())
  package_id Int
  field_name String
  column_no  Int
  package    config_package @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([package_id, field_name], map: "ux_config_package_field")
}

/**
 * Collateral Module — a SACCO member pledges a titled asset (vehicle, land, building) as
 * security for a loan above a threshold, or instead of guarantors. Four tables carry the
 * lifecycle: collateral_type (setup — LTV multiplier per category), collateral_application
 * (the maker-checker request to pledge one asset), collateral_register (the accepted,
 * read-only record of it once the application is Processed — shares its primary key with
 * the application, a 1:1 pair), and collateral_release (the maker-checker request to hand
 * it back). loan_collateral is the join between a loan and the register item(s) securing it
 * — Loan Securities' "Security Type = Collateral" rows, narrowed to just this one security
 * type since loan_guarantor already covers guarantor security separately.
 */

/// Setup: the catalogue of acceptable collateral types, each with its own loan-to-value
/// multiplier (a percentage, e.g. 70 = 70%) applied to a pledged asset's market value to
/// derive its realisable security value ("Guarantee").
model collateral_type {
  id                     Int                      @id @default(autoincrement())
  code                   String                   @unique
  description            String
  /// 'VEHICLE' | 'REAL_ESTATE'
  category               String
  value_multiplier       Float                    @default(0)
  status                 String                   @default("ACTIVE")
  collateral_application collateral_application[]
  collateral_register    collateral_register[]

  @@index([category], map: "ix_ctype_category")
}

/// The transactional document: one row per request to pledge one asset. Same
/// Open -> Pending Approval -> Approved -> Processed shape as account_opening_request —
/// processing (see lib/collateralApplications.ts's postCollateralApplication()) writes the
/// accepted asset into collateral_register under the same `no`.
model collateral_application {
  no                                String                              @id
  member_id                         Int
  category                          String
  collateral_type_id                Int?
  /// Snapshotted from collateral_type at the time it was picked — a later change to the
  /// type's own description must not retroactively change this document.
  collateral_description            String?
  /// Snapshotted LTV multiplier — see collateral_description.
  multiplier                        Float                               @default(0)
  /// Market/appraised value, minor units.
  collateral_value                  BigInt                              @default(0)
  /// = collateral_value * multiplier / 100, minor units. Always recomputed alongside
  /// collateral_value or collateral_type_id in the same service call, so it can never go
  /// stale the way the source AL implementation's field-level trigger allowed.
  guarantee                         BigInt                              @default(0)
  /// Vehicle registration / title deed number — identifies the physical asset. Checked for
  /// duplicates against the live register unless multi_linking is set.
  serial_reg_no                     String?
  /// Deliberately bypasses the duplicate serial/reg-no check — one asset pledged against
  /// several loans at once.
  multi_linking                     Int                                 @default(0)
  county_id                         Int?
  last_valuation_date               String?
  joint_ownership                   Int                                 @default(0)
  owner_name                        String?
  owner_id_no                       String?
  /// Registered owner's phone — a plain input, not derived from the member (the owner may
  /// not be the member; see Joint Ownership).
  owner_phone_no                    String?
  /// Vehicle only.
  insurance_expiry_date             String?
  car_track_due_date                String?
  cheque_no                         String?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                            String                              @default("Open")
  decision_reason                   String?
  processed_at                      String?
  processed_by                      String?
  created_at                        String?
  created_by                        String?
  member                            member                              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_type                   collateral_type?                    @relation(fields: [collateral_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  county                            county?                             @relation(fields: [county_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_application_attachment collateral_application_attachment[]
  collateral_register               collateral_register?

  @@index([member_id], map: "ix_capp_member")
  @@index([status], map: "ix_capp_status")
  @@index([serial_reg_no], map: "ix_capp_serial")
}

model collateral_application_attachment {
  id                     Int                    @id @default(autoincrement())
  application_no         String
  public_id              String                 @unique
  url                    String
  filename               String
  resource_type          String                 @default("image")
  format                 String?
  bytes                  Int                    @default(0)
  category               String?
  uploaded_at            String
  uploaded_by            String
  collateral_application collateral_application @relation(fields: [application_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([application_no], map: "ix_capp_attachment_no")
}

/// The register of accepted collateral. Shares its primary key with collateral_application —
/// one register row per Processed application (BR-14). Read-only through the UI; written only
/// by postCollateralApplication() and postCollateralRelease(). `status` (Available/Linked to
/// Loan/Collected) is deliberately not a stored column — see lib/collateralRegister.ts — it's
/// derived from whether a live loan_collateral row consumes cover and whether collected_at is
/// set, so an invalid combination can never be persisted.
model collateral_register {
  no                                String                              @id
  member_id                         Int
  category                          String
  collateral_type_id                Int?
  collateral_description            String?
  collateral_value                  BigInt                              @default(0)
  /// Captioned "LTV" in the UI — the realisable cover this item provides.
  guarantee                         BigInt                              @default(0)
  serial_reg_no                     String?
  posting_date                      String?
  county_id                         Int?
  owner_name                        String?
  owner_id_no                       String?
  owner_phone_no                    String?
  insurance_expiry_date             String?
  car_track_due_date                String?
  /// Set once a Processed collateral_release exists against this item.
  collected_at                      String?
  created_at                        String?
  collateral_application            collateral_application              @relation(fields: [no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  member                            member                              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_type                   collateral_type?                    @relation(fields: [collateral_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  county                            county?                             @relation(fields: [county_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_release                collateral_release[]
  loan_collateral                   loan_collateral[]
  loan_guarantor_change_replacement loan_guarantor_change_replacement[]

  @@index([member_id, collateral_type_id], map: "ix_creg_member_type")
  @@index([serial_reg_no], map: "ix_creg_serial")
}

/// A maker-checker request to hand a pledged asset back — the same Open -> Pending Approval
/// -> Approved -> Processed shape as every other request in this file. Processing (see
/// lib/collateralReleases.ts's postCollateralRelease()) stamps collateral_register.collected_at,
/// re-checking (not merely trusting the submit-time check) that the item no longer secures any
/// outstanding loan balance.
model collateral_release {
  no                  String              @id
  collateral_no       String
  member_id           Int
  collection_date     String?
  collected_by        String?
  collected_by_id_no  String?
  /// 'LOCAL' | 'DIASPORA'
  nationality         String              @default("LOCAL")
  /// Only meaningful when nationality = 'DIASPORA'.
  domicile_country    String?
  comments            String?
  remarks             String?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status              String              @default("Open")
  decision_reason     String?
  processed_at        String?
  processed_by        String?
  created_at          String?
  created_by          String?
  collateral_register collateral_register @relation(fields: [collateral_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  member              member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([collateral_no], map: "ix_crel_collateral")
  @@index([status], map: "ix_crel_status")
}

/// The join between a loan and the collateral register item(s) securing it — "Loan Securities"
/// narrowed to Security Type = Collateral (loan_guarantor already covers guarantor security
/// separately, so this table only ever carries collateral). `guarantee` is the cover this
/// specific loan draws from the item, snapshotted at attach time and capped to the item's own
/// available cover — see lib/loanCollateral.ts.
model loan_collateral {
  id                  Int                 @id @default(autoincrement())
  loan_id             Int
  collateral_no       String
  guarantee           BigInt
  /// 'ACTIVE' | 'SUBSTITUTED' — a substituted link is excluded from cover calculations,
  /// mirroring Loan Securities.Substituted, but kept for history rather than deleted.
  status              String              @default("ACTIVE")
  created_at          String?
  created_by          String?
  loan                loan                @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_register collateral_register @relation(fields: [collateral_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@unique([loan_id, collateral_no], map: "ux_loan_collateral")
  @@index([collateral_no], map: "ix_lc_collateral")
  @@index([loan_id], map: "ix_lc_loan")
}

/// Guarantor Change Management — maker-checker request to release and/or substitute guarantors
/// on an already-disbursed loan, ported from the AL reference's "Loan Security Mgmt." card
/// (Tab52204085 + Tab52204058 + Tab52204059) narrowed to Security Type = Guarantor only, since
/// collateral already has its own release lifecycle (collateral_release above). One header per
/// review, one line per guarantor currently COMMITTED to the loan at the time it was opened/last
/// refreshed, each line either released outright or covered by one or more replacement guarantors.
model loan_guarantor_change {
  no              String                       @id
  loan_id         Int
  /// The loan's own borrower, snapshotted from loan.member_id at creation.
  member_id       Int
  /// "Document Status" — the approval workflow state.
  status          String                       @default("Open")
  decision_reason String?
  processed_at    String?
  processed_by    String?
  created_at      String?
  created_by      String?
  loan            loan                         @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member          member                       @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines           loan_guarantor_change_line[]

  @@index([loan_id], map: "ix_lgc_loan")
  @@index([status], map: "ix_lgc_status")
}

/// One row per guarantor COMMITTED to the loan when this document was populated — the officer
/// marks it `release` (drop outright) or leaves it alone and attaches replacement rows instead.
model loan_guarantor_change_line {
  id                     Int                                 @id @default(autoincrement())
  change_no              String
  /// The currently-committed guarantor this line reviews.
  guarantor_member_id    Int
  /// Snapshot of loan_guarantor.amount at populate time.
  initial_guaranteed     BigInt                              @default(0)
  /// Snapshot of that guarantor's prorated exposure on this loan at populate time (same formula
  /// as lib/guarantors.ts's guaranteeSplit — capped at the loan's current outstanding balance).
  outstanding_guaranteed BigInt                              @default(0)
  release                Boolean                             @default(false)
  change                 loan_guarantor_change               @relation(fields: [change_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  guarantor_member       member                              @relation(fields: [guarantor_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacements           loan_guarantor_change_replacement[]

  @@unique([change_no, guarantor_member_id], map: "ux_lgcl_change_member")
  @@index([change_no], map: "ix_lgcl_change")
}

/// A proposed replacement covering (part of) a line's outstanding amount — AL's Det. Lines
/// (Tab52204059), one of three Security Types:
///   - GUARANTOR: another member (never the loan's own borrower — self-guarantee isn't a
///     loan_guarantor row in this schema, see lib/guarantors.ts's selfGuaranteeCapacity), vetted
///     against their own live guarantee capacity.
///   - COLLATERAL: a collateral_register item already registered to the loan's own borrower
///     (never anyone else's), vetted against its own live cover via
///     lib/collateralRegister.ts's getCollateralLinkedBalance().
///   - FIXED_DEPOSIT: a member_fixed_deposit belonging to the loan's own borrower, vetted against
///     lib/loanFdSecurity.ts's getFdLinkedBalance().
/// Processing (lib/loanGuarantorChanges.ts's processGuarantorChange()) writes a COLLATERAL/
/// FIXED_DEPOSIT replacement straight into loan_collateral/loan_fd_lien — the same tables the
/// loan card's own Attach Collateral/Attach FD Security actions use — bypassing their normal
/// "only while OPEN" gate, since an approved change document is its own authorization path onto
/// an already-DISBURSED loan.
model loan_guarantor_change_replacement {
  id                        Int                        @id @default(autoincrement())
  line_id                   Int
  replacement_type          String                     @default("GUARANTOR") // GUARANTOR | COLLATERAL | FIXED_DEPOSIT
  replacement_member_id     Int?
  replacement_collateral_no String?
  replacement_fd_no         String?
  amount                    BigInt                     @default(0)
  line                      loan_guarantor_change_line @relation(fields: [line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacement_member        member?                    @relation(fields: [replacement_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacement_collateral    collateral_register?       @relation(fields: [replacement_collateral_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  replacement_fd            member_fixed_deposit?      @relation(fields: [replacement_fd_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([line_id], map: "ix_lgcr_line")
  @@index([replacement_collateral_no], map: "ix_lgcr_collateral")
  @@index([replacement_fd_no], map: "ix_lgcr_fd")
}

/// Member Exit Module — the maker-checker process for terminating a membership, ported from the
/// AL reference's "Member Withdrawal" table (Tab52204055) narrowed to Document Type = Withdrawal
/// only (the sibling "Refund" variant on the same AL table is a partial-withdrawal-without-exit
/// feature of its own, out of scope here). Settles everything the member owns against everything
/// they owe (see lib/memberExits.ts's processMemberExit()), pays out the difference, and closes
/// their accounts.
model member_exit {
  no                    String              @id
  member_id             Int
  /// 'GENERAL' | 'RETIREE' | 'DECEASED' — AL's "Withdrawal Type". DECEASED skips the
  /// loan/guarantee liability checks (an estate isn't blocked on clearing loans first).
  exit_type             String              @default("GENERAL")
  /// 'FOSA' | 'BANK_TRANSFER' — AL's "Balance Option", which channel the final payout uses.
  payout_method         String              @default("FOSA")
  reason                String?
  /// AL's "Charge Code" — optional, posted via lib/charges.ts's postTransactionCharges() at
  /// processing time.
  transaction_charge_id Int?
  /// AL's "Instant" field (Tab52204055) — checking it auto-populates transaction_charge_id
  /// from organisation.instant_withdrawal_charge_id and, per AL's own
  /// MemberWithdrawalNotifications() filter (which excludes Instant records from the
  /// mature-for-posting reminder), also lets processMemberExit() skip the maturity wait.
  is_instant            Boolean             @default(false)
  exit_date             String?
  /// exit_date + organisation.member_exit_notice_days — processMemberExit() refuses to run
  /// before this date, same as AL's own maturity check.
  maturity_date         String?
  /// Snapshotted by populateLines()/refreshMemberExitLines() — total_assets (excl. share
  /// capital) + liabilities. Guarantees deliberately excluded, same as AL's own Net Amount.
  net_amount            BigInt              @default(0)
  /// The exit charge actually posted at processing time (loan.fees_charged's own precedent) —
  /// kept separately from net_amount rather than netted into it there, since net_amount also
  /// gates the "liabilities exceed assets" solvency check before a charge is even known. Zero
  /// until processed; the UI computes a live estimate before then.
  charge_amount         BigInt              @default(0)
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                String              @default("Open")
  decision_reason       String?
  processed_at          String?
  processed_by          String?
  created_at            String?
  created_by            String?
  member                member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines                 member_exit_line[]

  @@index([member_id], map: "ix_mex_member")
  @@index([status], map: "ix_mex_status")
}

/// One asset/liability/guarantee line snapshotted when the exit was opened or last refreshed.
/// Unlike AL's free-text "Account No", this carries real FKs into savings_account/loan — this
/// schema already has ids for both, so the card can link straight to the source record.
model member_exit_line {
  id                 Int              @id @default(autoincrement())
  exit_no            String
  /// 'ASSET' | 'LIABILITY' | 'GUARANTEE'
  entry_type         String
  /// Set for ASSET lines.
  savings_account_id Int?
  /// Set for LIABILITY (this member's own loan) and GUARANTEE (a loan this member guarantees
  /// for someone else) lines.
  loan_id            Int?
  account_name       String?
  balance            BigInt           @default(0)
  /// Signed: positive for an asset, negative for a liability or guarantee.
  amount             BigInt           @default(0)
  /// Share capital is captured for visibility but excluded from net_amount and never
  /// transferred/paid out during processing — matches AL's own Total Assets flowfield and
  /// posting loop, both of which explicitly exclude it.
  is_share_capital   Boolean          @default(false)
  exit               member_exit      @relation(fields: [exit_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  savings_account    savings_account? @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan               loan?            @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exit_no], map: "ix_mexl_exit")
}

/// Checkoff and Salary Processing — the employer master, ported from the AL reference's
/// "Employers" table (Tab52204126) narrowed to what routes a checkoff/salary batch: name/contact,
/// whether a payroll number is mandatory for its members, and status. The 59-file AL module this
/// narrows (Checkoff Upload/Calculation reconciliation ledgers, Standing Orders, Checkoff
/// Variations, Checkoff Advice, Employer Payroll Details staging, several analysis reports) is
/// scoped down in lib/checkoffBatches.ts's own header comment.
model employer {
  id                   Int              @id @default(autoincrement())
  code                 String           @unique
  name                 String
  phone                String?
  email                String?
  payroll_no_mandatory Boolean          @default(false)
  status               String           @default("ACTIVE")
  member               member[]
  checkoff_batch       checkoff_batch[]
}

/// A maker-checker batch document scoped to one employer/period: CHECKOFF lines compute each
/// member's expected loan-installment recovery and record what was actually remitted (the
/// reconciliation step), SALARY lines simply record each member's remitted net salary — see
/// lib/checkoffBatches.ts's processCheckoffBatch() for how each type posts.
model checkoff_batch {
  no                    String                 @id
  /// 'CHECKOFF' | 'SALARY'
  batch_type            String
  employer_id           Int
  /// First-of-month, e.g. '2026-08-01' — the payroll period this batch covers.
  period                String
  posting_date          String?
  description           String?
  /// 'MEMBER_NO' | 'ID_NUMBER' | 'PAYROLL_NO' | 'FOSA_NUMBER' — which column of an uploaded CSV
  /// identifies each row's member, and how it's resolved. Ported from the AL reference's
  /// "CheckOff Search Type" enum (Enum52204034), dropping its "Old FOSA Number" value — this
  /// port has no legacy-FOSA-number concept to search on. See applyCheckoffCsvUpload().
  search_type           String                 @default("PAYROLL_NO")
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                String                 @default("Open")
  decision_reason       String?
  /// SALARY only — the 'End Month Salary' Transaction Charge whose components (charges) and
  /// Transaction Recoveries (loan/internal-deposit waterfall) Calculate applies against each
  /// line's remitted amount. Null means Calculate has nothing configured to run.
  transaction_charge_id Int?
  processed_at          String?
  processed_by          String?
  created_at            String?
  created_by            String?
  employer              employer               @relation(fields: [employer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge?    @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines                 checkoff_batch_line[]
  calculations          checkoff_calculation[]

  @@index([employer_id], map: "ix_cob_employer")
  @@index([status], map: "ix_cob_status")
}

/// One member's line within a checkoff/salary batch.
model checkoff_batch_line {
  id              Int                    @id @default(autoincrement())
  batch_no        String
  member_id       Int
  payroll_no      String?
  /// CHECKOFF only — sum of this member's recovery_mode='CHECKOFF' disbursed loan installments,
  /// each capped at that loan's own outstanding balance. Always 0 for a SALARY line (this port
  /// excludes AL's Employer Payroll Details staging table, so there is nothing to compute an
  /// expected salary from — the officer records the actual remitted amount directly instead).
  expected_amount BigInt                 @default(0)
  /// What the officer records as actually remitted for this member — the reconciliation input
  /// both batch types share. A CSV upload that matches this line overwrites it with
  /// uploaded_amount.
  remitted_amount BigInt                 @default(0)
  /// remitted_amount - expected_amount (CHECKOFF only; always 0 for SALARY).
  variance        BigInt                 @default(0)
  /// The amount the last CSV upload carried for this member (0 if never uploaded or unmatched).
  uploaded_amount BigInt                 @default(0)
  /// The name column from the last CSV upload row that matched this line — kept for the officer
  /// to eyeball against the member's own name, since matching itself is by payroll/staff no.
  uploaded_name   String?
  /// False when the last CSV upload had a row that could not be matched to any line by payroll
  /// no — surfaced so "tally what is uploaded vs. what the card shows" has something to flag.
  matched         Boolean                @default(true)
  batch           checkoff_batch         @relation(fields: [batch_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  member          member                 @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calculations    checkoff_calculation[]

  @@unique([batch_no, member_id], map: "ux_cobl_batch_member")
}

/// One priority-ordered recovery rule attached to an 'End Month Salary' Transaction Charge —
/// ported from the AL reference's Tab52204065 "Transaction Recoveries", narrowed to the three
/// recovery types this app can actually act on without further master data: recovering a
/// member's own payroll-deducted loans, sweeping/topping-up one of their savings accounts, or
/// recovering their own salary_based Standing Order(s) directly (see standing_order.salary_based).
model transaction_recovery {
  id                    Int                @id @default(autoincrement())
  transaction_charge_id Int
  /// 'LOAN' | 'STANDING_ORDER' | 'INTERNAL_DEPOSIT'
  recovery_type         String
  /// LOAN: 'INSTALLMENT' | 'ARREARS' | 'BALANCE'. INTERNAL_DEPOSIT: 'FULL_REMAINING' |
  /// 'BOOST_TO_MINIMUM'. STANDING_ORDER: unused (null) — a standing order's own Amount Type
  /// (Fixed/Sweep) already decides how much it recovers.
  deduction_type        String?
  /// Required, INTERNAL_DEPOSIT only — which savings product's account to recover into.
  savings_product_id    Int?
  /// STANDING_ORDER only — matches a member's own salary_based, running standing order(s)
  /// directly by class (INTERNAL | EXTERNAL | LOAN); null matches any class. The standing order
  /// itself already carries every other instruction (amount, destination, charge) needed to
  /// recover it, so no separate type tag is kept here — configuring multiple STANDING_ORDER
  /// recoveries, each pinned to a different class with its own priority, is how "priority per
  /// class" is achieved — there is no separate per-class priority field, since Transaction
  /// Recoveries already orders by row.
  standing_order_class  String?
  priority              Int                @default(1)
  description           String?
  status                String             @default("ACTIVE")
  transaction_charge    transaction_charge @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_product       savings_product?   @relation(fields: [savings_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([transaction_charge_id], map: "ix_trec_tc")
}

/// One line of a Calculate run's breakdown for one checkoff_batch_line — a Transaction Charge
/// component, a Transaction Recovery deduction, or the net amount left over — kept for the
/// officer to review before Send for approval, and for processCheckoffBatch() to post from
/// (rather than recomputing at process time, so what was approved is exactly what posts).
model checkoff_calculation {
  id                 Int                 @id @default(autoincrement())
  batch_no           String
  line_id            Int
  /// 'CHARGE' | 'LOAN_RECOVERY' | 'STANDING_ORDER' | 'INTERNAL_DEPOSIT' | 'NET_AMOUNT'
  entry_type         String
  description        String
  loan_id            Int?
  savings_account_id Int?
  gl_account_id      Int?
  /// STANDING_ORDER only — processCheckoffBatch() re-derives the order's own destination and
  /// Charge Code from this at posting time rather than storing them separately.
  standing_order_no  String?
  amount             BigInt              @default(0)
  batch              checkoff_batch      @relation(fields: [batch_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  line               checkoff_batch_line @relation(fields: [line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  standing_order     standing_order?     @relation(fields: [standing_order_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([batch_no], map: "ix_cocalc_batch")
  @@index([line_id], map: "ix_cocalc_line")
  @@index([standing_order_no], map: "ix_cocalc_sto")
}

/// System Automation (Job Queue) — mirrors Business Central's Job Queue Entry: a recurring
/// background task, dispatched by job_type (see lib/jobQueue.ts's JOB_HANDLERS), that an admin
/// sets up and the in-process scheduler (instrumentation.ts) polls and runs unattended. AL's own
/// Recurrence (Day/Time-of-day patterns) is simplified to a plain "every N minutes" interval —
/// the same kind of simplification organisation.member_exit_notice_days already applies to a
/// DateFormula elsewhere in this port.
model job_queue_entry {
  id                  Int     @id @default(autoincrement())
  code                String  @unique
  description         String
  /// Which background task this entry runs — see lib/jobQueue.ts's JOB_HANDLERS. Currently only
  /// 'ENTRANCE_FEE_RECOVERY' is implemented.
  job_type            String
  run_every_minutes   Int     @default(60)
  /// The job never runs before this date, even if otherwise due — an optional go-live gate.
  earliest_start_date String?
  /// 'READY' | 'ON HOLD' — the two states an entry idles in between runs. A failed run does not
  /// flip this to some third "Error" state and stop recurring: it stays READY and simply carries
  /// the failure on last_run_status/last_run_message, so an admin can see and fix the underlying
  /// cause without also having to remember to re-enable the entry.
  status              String  @default("ON HOLD")
  next_run_at         String?
  last_run_at         String?
  /// 'SUCCESS' | 'ERROR'
  last_run_status     String?
  last_run_message    String?
  created_at          String?
  created_by          String?
  updated_at          String?
  updated_by          String?

  @@index([status], map: "ix_jqe_status")
}

/// FOSA cash-denomination master — AL "Denominations Setup" (Tab under Codeunit 52204019's
/// ValidateTransactionDenominations). One row per note/coin; `value` is in cents.
model denomination {
  id                     Int                      @id @default(autoincrement())
  code                   String                   @unique
  description            String
  value                  BigInt
  active                 Boolean                  @default(true)
  sort_order             Int                      @default(0)
  cash_denomination_line cash_denomination_line[]
}

/// The per-document denomination breakdown — AL "Transaction Denomination" (Tab52204045), one
/// shared table keyed by a document-kind discriminator ('FOSA' | 'TELLER') exactly as AL keys
/// its rows by the "FOSA Transaction Types" enum (which includes "Teller Transactions").
model cash_denomination_line {
  id              Int          @id @default(autoincrement())
  document_kind   String
  document_no     String
  denomination_id Int
  quantity        Int          @default(0)
  denomination    denomination @relation(fields: [denomination_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([document_kind, document_no, denomination_id])
  @@index([document_kind, document_no], map: "ix_cdl_document")
}

/// AL "Teller Setup" (Tab52204042) — links a user to the cash account they operate: a TELLER to
/// their own till (bank_account.account_type = 'TILL'), or a TREASURY user to the branch vault
/// (account_type = 'TREASURY'). Capacity limits gate fosa_transaction posting; approval_limit
/// gates whether a teller_transaction auto-posts or must be approved first.
model teller_setup {
  id              Int          @id @default(autoincrement())
  user_username   String
  setup_type      String
  bank_account_id Int
  max_capacity    BigInt       @default(0)
  min_capacity    BigInt       @default(0)
  approval_limit  BigInt       @default(0)
  created_at      String?
  created_by      String?
  bank_account    bank_account @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_username, setup_type])
  @@index([bank_account_id], map: "ix_ts_bank_account")
}

/// AL "FOSA Transactions" (Tab52204044) — the five treasury/till cash movements, one table with
/// a `document_type` discriminator: RECEIVE_FROM_BANK (Main Bank -> Treasury), TREASURY_REQUEST
/// (Treasury -> Till), INTER_TILL (Till -> Till), TREASURY_RETURN (Till -> Treasury),
/// SEND_TO_BANK (Treasury -> Main Bank). Maker-checker: Open -> Pending Approval -> Approved ->
/// Processed. Posting (lib/cashManagement.ts) is one balanced journal debiting the source bank
/// account's control G/L and crediting the destination's — postJournal() then maintains both
/// bank_account balances and the reconciliation subledger automatically.
model fosa_transaction {
  no                          String       @id
  document_type               String
  source_bank_account_id      Int
  destination_bank_account_id Int
  amount                      BigInt       @default(0)
  status                      String       @default("Open")
  decision_reason             String?
  posted                      Boolean      @default(false)
  journal_id                  Int?
  global_dimension_1_id       Int?
  global_dimension_2_id       Int?
  created_at                  String?
  created_by                  String?
  posted_at                   String?
  posted_by                   String?
  source_bank_account         bank_account @relation("ft_source", fields: [source_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_bank_account    bank_account @relation("ft_destination", fields: [destination_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal                     journal?     @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([document_type, status], map: "ix_ft_type_status")
  @@index([created_by], map: "ix_ft_created_by")
}

/// AL "Teller Transactions" (Tab52204046) — an over-the-counter member cash deposit or
/// withdrawal posted against the teller's own till. Auto-posts when the amount is within the
/// teller's Approval Limit (and the member is not staff); otherwise routes through maker-checker
/// approval first. Posting (lib/tellerTransactions.ts) debits/credits the till cash G/L against
/// the member's withdrawable-deposit control G/L, plus a configurable transaction charge.
model teller_transaction {
  no                    String              @id
  transaction_type      String
  member_id             Int
  savings_account_id    Int
  till_bank_account_id  Int
  teller_username       String
  amount                BigInt
  source_of_funds       String?
  transacted_by_name    String?
  transacted_by_id_no   String?
  transaction_charge_id Int?
  charge_amount         BigInt              @default(0)
  available_balance     BigInt              @default(0)
  book_balance          BigInt              @default(0)
  approval_required     Boolean             @default(false)
  status                String              @default("Open")
  decision_reason       String?
  posted                Boolean             @default(false)
  journal_id            Int?
  slip_emailed_at       String?
  global_dimension_1_id Int?
  global_dimension_2_id Int?
  created_at            String?
  created_by            String?
  posted_at             String?
  posted_by             String?
  member                member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account       savings_account     @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  till_bank_account     bank_account        @relation(fields: [till_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal               journal?            @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([transaction_type, status], map: "ix_tt_type_status")
  @@index([member_id], map: "ix_tt_member")
  @@index([created_by], map: "ix_tt_created_by")
}

/// AL "Lien" (Tab52204192 / Pages 52204235-6 / Cod52204007.PostAmountHolding). A maker-checker
/// instruction to place a HOLD on part of a member's deposit-account balance (making it
/// unavailable to withdraw / borrow against / sweep) or to RELEASE a previous hold. There is no
/// G/L posting — processing just moves savings_account.hold_amount, which every "available
/// balance" calculation in the app already subtracts (AL's "Uncleared Funds"). Lifecycle:
/// Open -> Pending Approval -> Approved -> Processed, with a Reopen back to Open while Approved
/// and not yet processed.
model member_lien {
  no                    String          @id
  member_id             Int
  savings_account_id    Int
  /// 'HOLD' | 'RELEASE'
  transaction_type      String
  amount                BigInt          @default(0)
  narration             String?
  posting_date          String
  status                String          @default("Open")
  decision_reason       String?
  processed             Boolean         @default(false)
  global_dimension_1_id Int?
  global_dimension_2_id Int?
  created_at            String?
  created_by            String?
  processed_at          String?
  processed_by          String?
  member                member          @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account       savings_account @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_lien_member")
  @@index([savings_account_id], map: "ix_lien_account")
  @@index([transaction_type, status], map: "ix_lien_type_status")
  @@index([created_by], map: "ix_lien_created_by")
}

/// Inter Account Transfer — AL Tab52204093 / Cod52204019.PostInterAccountTransfer. A maker-checker
/// instruction to move cash between two member deposit accounts (same member's other account, or a
/// different member's account when the creator holds the cross-member right). Only products
/// flagged `savings_product.allow_transfer` (AL's "Cash Transfer Allowed") can be the source.
/// Posting withdraws `amount` from the source, deposits it to the destination and deducts a
/// configurable transfer charge (organisation.inter_account_transfer_charge_id) from the source.
model inter_account_transfer {
  no                     String              @id
  source_member_id       Int
  source_account_id      Int
  destination_member_id  Int
  destination_account_id Int
  /// PARTIAL keeps the source above its product minimum balance; FULL may drain it to zero.
  amount_type            String              @default("PARTIAL")
  amount                 BigInt              @default(0)
  transaction_charge_id  Int?
  charge_amount          BigInt              @default(0)
  narration              String?
  posting_date           String
  status                 String              @default("Open")
  decision_reason        String?
  posted                 Boolean             @default(false)
  journal_id             Int?
  global_dimension_1_id  Int?
  global_dimension_2_id  Int?
  created_at             String?
  created_by             String?
  posted_at              String?
  posted_by              String?
  source_member          member              @relation("iat_source_member", fields: [source_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_member     member              @relation("iat_destination_member", fields: [destination_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_account         savings_account     @relation("iat_source_account", fields: [source_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_account    savings_account     @relation("iat_destination_account", fields: [destination_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge     transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([source_member_id], map: "ix_iat_source_member")
  @@index([destination_member_id], map: "ix_iat_dest_member")
  @@index([source_account_id], map: "ix_iat_source_account")
  @@index([status], map: "ix_iat_status")
  @@index([created_by], map: "ix_iat_created_by")
}

/// Cheque Types master — AL Tab52204122 (only the "Bankers Cheque" type is ported). One row per
/// kind of banker's cheque the SACCO sells: its ceiling, the clearing G/L account the issued
/// cheque is credited to, and the clearing charge deducted from the member.
model cheque_type {
  id                     Int                 @id @default(autoincrement())
  code                   String              @unique
  /// 'BANKERS' (lib/bankersCheques.ts) | 'EXTERNAL' (lib/chequeDeposits.ts) — AL Cheque Type enum.
  type                   String              @default("BANKERS")
  description            String
  maximum_amount         BigInt              @default(0)
  clearing_gl_account_id Int
  clearing_charge_id     Int?
  bouncing_charge_id     Int?
  express_charge_id      Int?
  in_house               Boolean             @default(false)
  /// AL "Maturity Period" (DateFormula) collapsed to a plain calendar-day count.
  maturity_days          Int                 @default(3)
  status                 String              @default("ACTIVE")
  created_at             String?
  created_by             String?
  clearing_gl_account    gl_account          @relation(fields: [clearing_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clearing_charge        transaction_charge? @relation("ct_clearing_charge", fields: [clearing_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bouncing_charge        transaction_charge? @relation("ct_bouncing_charge", fields: [bouncing_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  express_charge         transaction_charge? @relation("ct_express_charge", fields: [express_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bankers_cheque         bankers_cheque[]
  cheque_deposit         cheque_deposit[]
}

/// Cheque Deposit — AL Tab52204124. A member banks a third-party cheque; it clears to their
/// account on its maturity date (clearing charge), or bounces (bouncing charge), or is
/// express-cleared before maturity (express charge + a hold on the account until the real
/// maturity date). Lifecycle Open -> Pending Approval -> Approved -> Cleared | Bounced.
model cheque_deposit {
  no                     String               @id
  cheque_type_id         Int
  description            String?
  member_id              Int
  savings_account_id     Int
  cheque_no              String?
  cheque_date            String?
  deposit_date           String
  maturity_date          String
  in_house               Boolean              @default(false)
  amount                 BigInt               @default(0)
  express_cheque         Boolean              @default(false)
  drawer_account_name    String?
  drawer_bank            String?
  drawer_branch          String?
  drawer_account_no      String?
  clearing_gl_account_id Int
  clearing_charge_id     Int?
  bouncing_charge_id     Int?
  express_charge_id      Int?
  /// The charge actually taken on clearing / bouncing (recomputed at post time).
  charge_amount          BigInt               @default(0)
  /// Amount currently held on the account from an express clearance (0 once released at maturity).
  express_hold_amount    BigInt               @default(0)
  status                 String               @default("Open")
  decision_reason        String?
  cleared_by             String?
  clearance_date         String?
  journal_id             Int?
  global_dimension_1_id  Int?
  global_dimension_2_id  Int?
  created_at             String?
  created_by             String?
  cheque_type            cheque_type          @relation(fields: [cheque_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member                 member               @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account        savings_account      @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clearing_gl_account    gl_account           @relation("cd_clearing_gl_account", fields: [clearing_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clearing_charge        transaction_charge?  @relation("cd_clearing_charge", fields: [clearing_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cheque_instruction     cheque_instruction[]

  @@index([member_id], map: "ix_cd_member")
  @@index([savings_account_id], map: "ix_cd_account")
  @@index([status], map: "ix_cd_status")
  @@index([created_by], map: "ix_cd_created_by")
  @@index([maturity_date], map: "ix_cd_maturity")
}

/// Cheque Instructions — AL Tab52204087. When a cheque deposit clears, move part of the funds
/// from the deposit account to another of the same member's savings accounts, and/or apply it to
/// one of their disbursed loans. Executed when the funds are confirmed (normal clearing, or
/// when an express clearance's hold is released at maturity).
model cheque_instruction {
  id                 Int              @id @default(autoincrement())
  cheque_deposit_no  String
  line_no            Int              @default(0)
  /// 'ACCOUNT' | 'LOAN'
  target_type        String           @default("ACCOUNT")
  savings_account_id Int?
  loan_id            Int?
  amount             BigInt           @default(0)
  created_at         String?
  created_by         String?
  cheque_deposit     cheque_deposit   @relation(fields: [cheque_deposit_no], references: [no], onDelete: Cascade, onUpdate: NoAction)
  savings_account    savings_account? @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan               loan?            @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cheque_deposit_no], map: "ix_ci_deposit")
}

/// Bankers Cheque — AL Tab52204123. A maker-checker sale of a banker's cheque against a member's
/// deposit account: on posting the member's account is debited `amount` (+ clearing charge) and
/// the cheque type's clearing G/L account is credited `amount`. Lifecycle Open -> Pending
/// Approval -> Approved -> Processed, same shape as lib/liens.ts / lib/interAccountTransfer.ts.
model bankers_cheque {
  no                    String              @id
  cheque_type_id        Int
  /// Snapshot of the cheque type's description / ceiling at capture time.
  description           String?
  max_amount            BigInt              @default(0)
  member_id             Int
  savings_account_id    Int
  payee_details         String?
  /// The physical cheque leaf number entered by the teller.
  cheque_no             String?
  book_balance          BigInt              @default(0)
  amount                BigInt              @default(0)
  transaction_charge_id Int?
  charge_amount         BigInt              @default(0)
  net_amount            BigInt              @default(0)
  posting_date          String
  status                String              @default("Open")
  decision_reason       String?
  posted                Boolean             @default(false)
  journal_id            Int?
  global_dimension_1_id Int?
  global_dimension_2_id Int?
  created_at            String?
  created_by            String?
  posted_at             String?
  posted_by             String?
  cheque_type           cheque_type         @relation(fields: [cheque_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member                member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account       savings_account     @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_bcq_member")
  @@index([savings_account_id], map: "ix_bcq_account")
  @@index([status], map: "ix_bcq_status")
  @@index([created_by], map: "ix_bcq_created_by")
  @@index([posting_date], map: "ix_bcq_posting_date")
}

/**
 * =============================================================== Inventory
 */
/**
 * Business Central-style Inventory: Locations (multi-location), Units of Measure (with a
 * per-item Base/Purchase/Sales conversion), an Item card with Reorder Point/Quantity/Maximum
 * Inventory and a Costing Method, and Item Journal Lines that post Positive/Negative Adjustments
 * through the same postJournal() engine every other module uses. No AL source exists for this —
 * see lib/itemJournal.ts's header comment for the full design rationale.
 */

/// A stock-keeping location (Business Central Table 14, trimmed). Every Item Ledger Entry and
/// Item Journal Line happens at one of these.
model location {
  id                Int                 @id @default(autoincrement())
  code              String              @unique
  name              String
  address           String?
  status            String              @default("ACTIVE")
  created_at        String?
  created_by        String?
  stockkeeping_unit stockkeeping_unit[]
  item_journal_line item_journal_line[]
  item_ledger_entry item_ledger_entry[]
}

/// Business Central Table 204. A global catalogue of units (EACH, BOX, KG, …); an item picks
/// which of these it may be entered in via item_unit_of_measure.
model unit_of_measure {
  id                                                  Int                    @id @default(autoincrement())
  code                                                String                 @unique
  description                                         String
  symbol                                              String?
  created_at                                          String?
  created_by                                          String?
  item_unit_of_measure                                item_unit_of_measure[]
  item_item_base_unit_of_measure_idTounit_of_measure  item[]                 @relation("item_base_uom")
  item_item_purch_unit_of_measure_idTounit_of_measure item[]                 @relation("item_purch_uom")
  item_item_sales_unit_of_measure_idTounit_of_measure item[]                 @relation("item_sales_uom")
  item_journal_line                                   item_journal_line[]
}

/// A simplification of Business Central's Inventory Posting Setup + General Posting Setup: one
/// master carrying the two G/L accounts an Item Journal posting moves between — the Inventory
/// account (an asset) and the Adjustment account (an expense/contra the Positive/Negative Adjmt.
/// posts against), the same way cheque_type bundles a clearing G/L account for its own document.
model inventory_posting_group {
  id                      Int        @id @default(autoincrement())
  code                    String     @unique
  description             String
  inventory_gl_account_id Int
  created_at              String?
  created_by              String?
  inventory_gl_account    gl_account @relation("ipg_inventory_gl", fields: [inventory_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item                    item[]
}

/// Business Central's Gen. Prod. Posting Group (the other half of the real General Posting Setup
/// keying — Gen. Bus. Posting Group has no counterpart here, since this module has no
/// customer/vendor-side transactions to combine it with). Every Item also carries one; it names
/// the P&L account a Positive/Negative Adjmt. offsets against. Kept independent of
/// inventory_posting_group exactly as Business Central keeps the two posting-group axes
/// independent — the same G/L account can be reused across item families whose inventory
/// accounts differ, and vice versa — so the subledger (this) and ledger (inventory_posting_group)
/// side of a posting are each configured, and each reconciled, on their own.
model product_posting_group {
  id                       Int         @id @default(autoincrement())
  code                     String      @unique
  description              String
  adjustment_gl_account_id Int
  sales_gl_account_id      Int?
  cogs_gl_account_id       Int?
  created_at               String?
  created_by               String?
  adjustment_gl_account    gl_account  @relation("ppg_adjustment_gl", fields: [adjustment_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_gl_account         gl_account? @relation("ppg_sales_gl", fields: [sales_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cogs_gl_account          gl_account? @relation("ppg_cogs_gl", fields: [cogs_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item                     item[]
}

/// Business Central Table 27 "Item", trimmed to what this SACCO's back office needs: no locations
/// beyond the multi-location stock split (stockkeeping_unit), no variants/serials/lots, no Item
/// Charges. `inventory` is a maintained roll-up of this item's stockkeeping_unit rows (the same
/// cached-running-total idea as gl_account.balance). Reordering fields are this item's defaults —
/// a stockkeeping_unit row may override them per location.
model item {
  id                         Int                     @id @default(autoincrement())
  no                         String                  @unique
  description                String
  description_2              String?
  base_unit_of_measure_id    Int
  purch_unit_of_measure_id   Int?
  sales_unit_of_measure_id   Int?
  inventory_posting_group_id Int
  product_posting_group_id   Int
  /// 'FIFO' | 'LIFO' | 'Average' | 'Standard' | 'Specific' — Business Central's own five.
  costing_method             String                  @default("FIFO")
  unit_cost                  BigInt                  @default(0)
  unit_price                 BigInt                  @default(0)
  inventory                  Int                     @default(0)
  /// 'Fixed Reorder Qty.' | 'Maximum Qty.' — feeds lib/itemJournal.ts's calculateReplenishment().
  reordering_policy          String                  @default("Fixed Reorder Qty.")
  reorder_point              Int                     @default(0)
  reorder_quantity           Int                     @default(0)
  maximum_inventory          Int                     @default(0)
  status                     String                  @default("ACTIVE")
  created_at                 String?
  created_by                 String?
  base_unit_of_measure       unit_of_measure         @relation("item_base_uom", fields: [base_unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purch_unit_of_measure      unit_of_measure?        @relation("item_purch_uom", fields: [purch_unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales_unit_of_measure      unit_of_measure?        @relation("item_sales_uom", fields: [sales_unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_posting_group    inventory_posting_group @relation(fields: [inventory_posting_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_posting_group      product_posting_group   @relation(fields: [product_posting_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item_unit_of_measure       item_unit_of_measure[]
  stockkeeping_unit          stockkeeping_unit[]
  item_journal_line          item_journal_line[]
  item_ledger_entry          item_ledger_entry[]

  @@index([status], map: "ix_item_status")
}

/// Business Central Table 5404. Which units an item may be entered in, and each one's conversion
/// factor to that item's Base UoM (BC never converts UoM-to-UoM, only ever via Base) — see
/// lib/unitOfMeasureConversion.ts.
model item_unit_of_measure {
  id                      Int             @id @default(autoincrement())
  item_id                 Int
  unit_of_measure_id      Int
  qty_per_unit_of_measure Int             @default(1)
  item                    item            @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit_of_measure         unit_of_measure @relation(fields: [unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([item_id, unit_of_measure_id])
}

/// Business Central Table 5700 "Stockkeeping Unit" — per item+location qty-on-hand, with an
/// optional per-location override of the item's Reordering Policy/Reorder Point/Reorder
/// Quantity/Maximum Inventory (null = inherit the item's own default). Auto-created the first
/// time an item posts at a location — see postItemJournalLine() in lib/itemJournal.ts.
model stockkeeping_unit {
  id                Int      @id @default(autoincrement())
  item_id           Int
  location_id       Int
  reordering_policy String?
  reorder_point     Int?
  reorder_quantity  Int?
  maximum_inventory Int?
  inventory         Int      @default(0)
  item              item     @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  location          location @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([item_id, location_id])
}

/// Business Central Table 83 "Item Journal Line", scoped to Positive/Negative Adjmt. only.
/// Lifecycle Open -> Pending Approval -> Approved -> Processed, same shape as bankers_cheque.
/// `journal_id` and `applies_to_entry_id` are plain reference columns (no FK constraint), the
/// same convention bankers_cheque.journal_id uses — see lib/itemJournal.ts.
model item_journal_line {
  id                      Int                 @id @default(autoincrement())
  no                      String              @unique
  posting_date            String
  /// 'Positive Adjmt.' | 'Negative Adjmt.'
  entry_type              String
  item_id                 Int
  location_id             Int
  description             String?
  unit_of_measure_id      Int
  /// Snapshot of item_unit_of_measure.qty_per_unit_of_measure at entry time.
  qty_per_unit_of_measure Int                 @default(1)
  /// Entered in unit_of_measure_id's unit.
  quantity                Int                 @default(0)
  /// quantity * qty_per_unit_of_measure — what actually moves stock, in the item's Base UoM.
  base_quantity           Int                 @default(0)
  /// Specific costing only — the one open lot (item_ledger_entry.id) this outbound line applies
  /// against. No FK constraint (see model comment).
  applies_to_entry_id     Int?
  unit_cost               BigInt              @default(0)
  amount                  BigInt              @default(0)
  status                  String              @default("Open")
  decision_reason         String?
  posted                  Boolean             @default(false)
  /// The posted G/L journal, once posted. No FK constraint (see model comment).
  journal_id              Int?
  global_dimension_1_id   Int?
  global_dimension_2_id   Int?
  created_at              String?
  created_by              String?
  posted_at               String?
  posted_by               String?
  item                    item                @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location                location            @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit_of_measure         unit_of_measure     @relation(fields: [unit_of_measure_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemLedgerEntries       item_ledger_entry[]

  @@index([item_id], map: "ix_ijl_item")
  @@index([location_id], map: "ix_ijl_location")
  @@index([status], map: "ix_ijl_status")
  @@index([created_by], map: "ix_ijl_created_by")
  @@index([posting_date], map: "ix_ijl_posting_date")
}

/// Business Central Table 32 "Item Ledger Entry" — the posted, immutable stock movement. An
/// inbound (Positive Adjmt.) entry is a costed lot: `remaining_quantity`/`open` track how much of
/// it is still unconsumed. An outbound (Negative Adjmt.) entry's `unit_cost` is whatever the
/// costing engine determined (see lib/itemJournal.ts) and leaves remaining_quantity/open at 0/false.
model item_ledger_entry {
  id                                                                                 Int                      @id @default(autoincrement())
  item_id                                                                            Int
  location_id                                                                        Int
  posting_date                                                                       String
  entry_type                                                                         String
  document_no                                                                        String
  /// Signed, in the item's Base UoM: positive for an inbound lot, negative for an outbound entry.
  quantity                                                                           Int
  /// Inbound lots only — how much of this lot has not yet been applied to an outbound entry.
  remaining_quantity                                                                 Int                      @default(0)
  /// Inbound lots only — true while remaining_quantity > 0.
  open                                                                               Boolean                  @default(false)
  unit_cost                                                                          BigInt                   @default(0)
  amount                                                                             BigInt                   @default(0)
  /// Null for an outbound entry written by a sales shipment/invoice (lib/salesDocuments.ts)
  /// rather than the Item Journal.
  item_journal_line_id                                                               Int?
  created_at                                                                         String?
  item                                                                               item                     @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location                                                                           location                 @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item_journal_line                                                                  item_journal_line?       @relation(fields: [item_journal_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item_application_entry_item_application_entry_outbound_entry_idToitem_ledger_entry item_application_entry[] @relation("iae_outbound")
  item_application_entry_item_application_entry_inbound_entry_idToitem_ledger_entry  item_application_entry[] @relation("iae_inbound")

  @@index([item_id], map: "ix_ile_item")
  @@index([location_id], map: "ix_ile_location")
}

/// Business Central Table 339 "Item Application Entry" — which inbound lot(s) an outbound entry
/// consumed, and how much of each. Written by the costing engine for FIFO/LIFO/Average/Specific
/// (Standard skips lot application entirely — see lib/itemJournal.ts).
model item_application_entry {
  id                Int               @id @default(autoincrement())
  outbound_entry_id Int
  inbound_entry_id  Int
  quantity          Int
  posting_date      String
  created_at        String?
  outbound_entry    item_ledger_entry @relation("iae_outbound", fields: [outbound_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inbound_entry     item_ledger_entry @relation("iae_inbound", fields: [inbound_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([outbound_entry_id], map: "ix_iae_outbound")
  @@index([inbound_entry_id], map: "ix_iae_inbound")
}

/// Business Central Table 5628 "FA Class".
model fa_class {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String
  status      String  @default("ACTIVE")
  created_at  String?
  created_by  String?
}

/// Business Central Table 5629 "FA Subclass".
model fa_subclass {
  id            Int     @id @default(autoincrement())
  code          String  @unique
  description   String
  fa_class_code String?
  status        String  @default("ACTIVE")
  created_at    String?
  created_by    String?
}

/// Business Central Table 5643 "FA Location" — where an asset physically sits. Separate from the
/// Inventory location master.
model fa_location {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String
  status      String  @default("ACTIVE")
  created_at  String?
  created_by  String?
}

/// Business Central Table 5611 "Depreciation Book". This port always integrates to the G/L.
model depreciation_book {
  id                            Int                    @id @default(autoincrement())
  code                          String                 @unique
  description                   String
  g_l_integration               Int                    @default(1)
  default_final_rounding_amount BigInt                 @default(0)
  use_rounding_in_periodic_depr Int                    @default(0)
  created_at                    String?
  created_by                    String?
  fa_depreciation_book          fa_depreciation_book[]
  fa_journal_line               fa_journal_line[]
  fa_ledger_entry               fa_ledger_entry[]
}

/// Business Central Table 5606 "FA Posting Group" (trimmed — book-value / proceeds-on-disposal
/// accounts are netted into the gains / losses accounts here). Every FA G/L posting resolves its
/// debit and credit from the asset's posting group. See lib/faJournal.ts.
model fa_posting_group {
  id                              Int                    @id @default(autoincrement())
  code                            String                 @unique
  description                     String
  acquisition_cost_account_id     Int
  accum_depreciation_account_id   Int
  depreciation_expense_account_id Int
  write_down_expense_account_id   Int
  appreciation_account_id         Int
  maintenance_expense_account_id  Int
  gains_acc_on_disposal_id        Int
  losses_acc_on_disposal_id       Int
  created_at                      String?
  created_by                      String?
  acquisition_cost_account        gl_account             @relation("fapg_acquisition_cost", fields: [acquisition_cost_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accum_depreciation_account      gl_account             @relation("fapg_accum_depreciation", fields: [accum_depreciation_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  depreciation_expense_account    gl_account             @relation("fapg_depreciation_expense", fields: [depreciation_expense_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  write_down_expense_account      gl_account             @relation("fapg_write_down_expense", fields: [write_down_expense_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appreciation_account            gl_account             @relation("fapg_appreciation", fields: [appreciation_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenance_expense_account     gl_account             @relation("fapg_maintenance_expense", fields: [maintenance_expense_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gains_acc_on_disposal           gl_account             @relation("fapg_gains_on_disposal", fields: [gains_acc_on_disposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  losses_acc_on_disposal          gl_account             @relation("fapg_losses_on_disposal", fields: [losses_acc_on_disposal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fa_depreciation_book            fa_depreciation_book[]
}

/// Business Central Table 5603 "FA Setup" — singleton (id is always 1). FA Nos. / FA Journal
/// Nos. are handled by the No. Series module, not stored here.
model fa_setup {
  id                             Int     @id @default(1)
  default_depreciation_book_code String?
  default_fa_posting_group_code  String?
  allow_fa_posting_from          String?
  allow_fa_posting_to            String?
  updated_at                     String?
  updated_by                     String?
}

/// Business Central Table 5616 "Maintenance" — the master list of maintenance / service types.
model maintenance {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String
  status      String  @default("ACTIVE")
  created_at  String?
  created_by  String?
}

/// Business Central Table 5600 "Fixed Asset". acquisition_date / disposal_date are stamped by
/// posting, never entered.
model fixed_asset {
  id                       Int                       @id @default(autoincrement())
  no                       String                    @unique
  description              String
  description_2            String?
  fa_class_code            String?
  fa_subclass_code         String?
  fa_location_code         String?
  responsible_employee     String?
  serial_no                String?
  vendor_name              String?
  asset_tag                String?
  global_dimension_1_id    Int?
  global_dimension_2_id    Int?
  blocked                  Int                       @default(0)
  inactive                 Int                       @default(0)
  acquisition_date         String?
  disposal_date            String?
  created_at               String?
  created_by               String?
  global_dimension_1_value global_dimension_1_value? @relation(fields: [global_dimension_1_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_dimension_2_value global_dimension_2_value? @relation(fields: [global_dimension_2_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fa_depreciation_book     fa_depreciation_book[]
  fa_journal_line          fa_journal_line[]
  fa_ledger_entry          fa_ledger_entry[]

  @@index([fa_class_code], map: "ix_fa_class")
  @@index([fa_location_code], map: "ix_fa_location")
}

/// Business Central Table 5612 "FA Depreciation Book" — one row per asset + book, carrying the
/// depreciation parameters and a maintained roll-up of the ledger amounts. See
/// lib/fixedAssetDepreciation.ts.
model fa_depreciation_book {
  id                          Int               @id @default(autoincrement())
  fixed_asset_id              Int
  depreciation_book_code      String
  fa_posting_group_code       String
  /// 'Straight-Line' | 'Declining-Balance 1' | 'DB1/SL' | 'Manual'
  depreciation_method         String            @default("Straight-Line")
  depreciation_starting_date  String?
  depreciation_ending_date    String?
  no_of_depreciation_years    Float?
  straight_line_pct           Float             @default(0)
  declining_balance_pct       Float             @default(0)
  fixed_depr_amount           BigInt            @default(0)
  salvage_value               BigInt            @default(0)
  last_depreciation_date      String?
  /// 'Net' | 'Gross'
  disposal_calculation_method String            @default("Net")
  acquisition_cost            BigInt            @default(0)
  accumulated_depreciation    BigInt            @default(0)
  write_down_amount           BigInt            @default(0)
  appreciation_amount         BigInt            @default(0)
  book_value                  BigInt            @default(0)
  proceeds_on_disposal        BigInt            @default(0)
  gain_loss_on_disposal       BigInt            @default(0)
  maintenance_total           BigInt            @default(0)
  disposed                    Int               @default(0)
  fixed_asset                 fixed_asset       @relation(fields: [fixed_asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  depreciation_book           depreciation_book @relation(fields: [depreciation_book_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  fa_posting_group            fa_posting_group  @relation(fields: [fa_posting_group_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fixed_asset_id, depreciation_book_code])
  @@index([depreciation_book_code], map: "ix_fadb_book")
}

/// The FA Journal — a maker-checker document, same lifecycle shape as item_journal_line
/// (Open -> Pending Approval -> Approved -> Processed). journal_id carries no FK, matching the
/// loose convention item_journal_line.journal_id already uses.
model fa_journal_line {
  id                         Int               @id @default(autoincrement())
  no                         String            @unique
  posting_date               String
  document_no                String?
  fixed_asset_id             Int
  depreciation_book_code     String
  /// 'Acquisition Cost' | 'Depreciation' | 'Write-Down' | 'Appreciation' | 'Disposal' | 'Maintenance'
  fa_posting_type            String
  amount                     BigInt            @default(0)
  balancing_gl_account_id    Int?
  maintenance_code           String?
  depr_until_fa_posting_date Int               @default(0)
  no_of_depreciation_days    Int?
  description                String?
  /// 'MANUAL' | 'CALCULATE_DEPRECIATION'
  source                     String            @default("MANUAL")
  status                     String            @default("Open")
  decision_reason            String?
  posted                     Boolean           @default(false)
  journal_id                 Int?
  created_at                 String?
  created_by                 String?
  posted_at                  String?
  posted_by                  String?
  fixed_asset                fixed_asset       @relation(fields: [fixed_asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  depreciation_book          depreciation_book @relation(fields: [depreciation_book_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  balancing_gl_account       gl_account?       @relation(fields: [balancing_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fa_ledger_entry            fa_ledger_entry[]

  @@index([fixed_asset_id], map: "ix_faj_asset")
  @@index([status], map: "ix_faj_status")
  @@index([created_by], map: "ix_faj_created_by")
  @@index([posting_date], map: "ix_faj_posting_date")
}

/// Business Central Table 5601 "FA Ledger Entry" — the posted, immutable FA movement. amount is
/// signed (negative for Depreciation / Write-Down, positive for Acquisition / Appreciation).
model fa_ledger_entry {
  id                      Int               @id @default(autoincrement())
  fixed_asset_id          Int
  depreciation_book_code  String
  fa_posting_date         String
  fa_posting_type         String
  document_no             String
  description             String?
  amount                  BigInt            @default(0)
  no_of_depreciation_days Int?
  journal_id              Int?
  fa_journal_line_id      Int?
  part_of_book_value      Int               @default(1)
  maintenance_code        String?
  reversed                Int               @default(0)
  created_at              String?
  fixed_asset             fixed_asset       @relation(fields: [fixed_asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  depreciation_book       depreciation_book @relation(fields: [depreciation_book_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  fa_journal_line         fa_journal_line?  @relation(fields: [fa_journal_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fixed_asset_id, depreciation_book_code], map: "ix_fale_asset_book")
  @@index([fa_posting_date], map: "ix_fale_date")
  @@index([fa_posting_type], map: "ix_fale_type")
}

/// Business Central Table 92 "Customer Posting Group".
model customer_posting_group {
  id                             Int        @id @default(autoincrement())
  code                           String     @unique
  description                    String
  receivables_account_id         Int
  service_charge_account_id      Int
  additional_fee_account_id      Int
  payment_disc_debit_account_id  Int
  payment_disc_credit_account_id Int
  invoice_rounding_account_id    Int
  created_at                     String?
  created_by                     String?
  receivables_account            gl_account @relation("cpg_receivables", fields: [receivables_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service_charge_account         gl_account @relation("cpg_service_charge", fields: [service_charge_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  additional_fee_account         gl_account @relation("cpg_additional_fee", fields: [additional_fee_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_disc_debit_account     gl_account @relation("cpg_pmt_disc_debit", fields: [payment_disc_debit_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_disc_credit_account    gl_account @relation("cpg_pmt_disc_credit", fields: [payment_disc_credit_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_rounding_account       gl_account @relation("cpg_invoice_rounding", fields: [invoice_rounding_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Business Central Table 3 "Payment Terms".
model payment_terms {
