/// A member fixed-deposit product: interest rate bounds, calc method (Flat vs Reducing Balance,
/// ported from AL's Cod52204010.CreateFixedDepositSchedule), the savings_product new FD accounts
/// open under, and the GL accounts interest accrual/withholding tax post to. Admin-managed master
/// data, no workflow — mirrors lib/collateralTypes.ts's shape.
model member_fixed_deposit_type {
  id                     Int                    @id @default(autoincrement())
  code                   String                 @unique
  description            String
  min_interest_rate      Float                  @default(0)
  max_interest_rate      Float                  @default(0)
  interest_calc_type     String                 @default("FLAT") // 'FLAT' | 'REDUCING'
  linked_product_id      Int
  interest_expense_gl_id Int
  interest_payable_gl_id Int
  withholding_tax_rate   Float                  @default(0)
  withholding_tax_gl_id  Int?
  status                 String                 @default("ACTIVE")
  savings_product        savings_product        @relation(fields: [linked_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interest_expense_account gl_account           @relation("mfdt_interest_expense", fields: [interest_expense_gl_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interest_payable_account gl_account           @relation("mfdt_interest_payable", fields: [interest_payable_gl_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  withholding_tax_account  gl_account?          @relation("mfdt_withholding_tax", fields: [withholding_tax_gl_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_fixed_deposit   member_fixed_deposit[]
}

/// The maker-checker document for a member's term deposit — Open -> Pending Approval -> Approved,
/// then its own richer post-approval lifecycle (Active -> Matured/Terminated) tracked directly in
/// `status` rather than the shared 4-state DocumentStatus, same reason `loan.status` isn't either.
/// See lib/fixedDeposits.ts. Ported from AL's Tab52204018 "Member Fixed Deposits".
model member_fixed_deposit {
  no                    String                         @id
  member_id             Int
  fd_type_id            Int
  rate                  Float
  maturity_instructions String                         @default("LIQUIDATE") // ROLLOVER_PRINCIPAL | ROLLOVER_NET | LIQUIDATE
  amount                BigInt
  source_account_id     Int
  /// The FD's own dedicated savings_account (product = the type's linked_product_id), created on
  /// activation — holds exactly `amount` until maturity/termination pays it out.
  fd_account_id         Int?
  start_date            String
  term_months           Int
  end_date              String
  status                String                         @default("Open") // Open | Pending Approval | Approved | Active | Matured | Terminated
  decision_reason       String?
  /// Roll-over chain — set on both sides when maturity creates a successor FD.
  rolled_from_no        String?
  rolled_to_no          String?
  created_at            String?
  created_by            String?
  activated_at          String?
  activated_by          String?
  processed_at          String?
  processed_by          String?
  member                member                         @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_fixed_deposit_type member_fixed_deposit_type  @relation(fields: [fd_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_account        savings_account                @relation("mfd_source_account", fields: [source_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fd_account            savings_account?               @relation("mfd_fd_account", fields: [fd_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_fixed_deposit_schedule member_fixed_deposit_schedule[]
  loan_fd_lien          loan_fd_lien[]
  loan_guarantor_change_replacement loan_guarantor_change_replacement[]

  @@index([member_id], map: "ix_mfd_member")
  @@index([status], map: "ix_mfd_status")
}

/// Monthly interest accrual line for a Member Fixed Deposit — ported from AL's Tab52204019
/// "Member Fixed Deposit Schedule". `transferred` flips once its GL accrual journal has posted
/// (lib/fixedDeposits.ts's accrueFixedDepositInterest); maturity sums every row regardless.
model member_fixed_deposit_schedule {
  id           Int                  @id @default(autoincrement())
  fd_no        String
  posting_date String
  description  String?
  amount       BigInt               @default(0)
  transferred  Boolean              @default(false)
  member_fixed_deposit member_fixed_deposit @relation(fields: [fd_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([fd_no], map: "ix_mfds_fd_no")
}

/// A Fixed Deposit pledged as security for a loan — the FD-as-collateral sibling of
/// loan_collateral (which covers physical collateral_register items; loan_guarantor covers
/// guarantor security). See lib/loanFdSecurity.ts. Attach/detach only while the loan is OPEN,
/// same point loan_collateral/loan_guarantor are fixed.
model loan_fd_lien {
  id         Int                  @id @default(autoincrement())
  loan_id    Int
  fd_no      String
  guarantee  BigInt
  status     String               @default("ACTIVE") // ACTIVE | RELEASED
  created_at String?
  created_by String?
