model acc_schedule_line {
  id                   Int               @id @default(autoincrement())
  acc_schedule_name_id Int
  line_no              Int               @default(0)
  row_no               String            @default("")
  description          String            @default("")
  /// POSTING_ACCOUNTS | TOTAL_ACCOUNTS | FORMULA | SET_BASE_FOR_PERCENT
  totaling_type        String            @default("POSTING_ACCOUNTS")
  totaling             String            @default("")
  /// NET_AMOUNT | DEBIT_AMOUNT | CREDIT_AMOUNT
  amount_type          String            @default("NET_AMOUNT")
  /// NET_CHANGE | BALANCE_AT_DATE | BEGINNING_BALANCE — overrides the column window when not NET_CHANGE
  row_type             String            @default("NET_CHANGE")
  /// YES | NO | IF_ANY_NOT_ZERO | IF_ALL_ZERO
  show                 String            @default("YES")
  bold                 Int               @default(0)
  italic               Int               @default(0)
  underline            Int               @default(0)
  double_underline     Int               @default(0)
  show_opposite_sign   Int               @default(0)
  new_page             Int               @default(0)
  indentation          Int               @default(0)
  dimension_1_totaling String            @default("")
  dimension_2_totaling String            @default("")
  created_at           String?
  created_by           String?
  acc_schedule_name    acc_schedule_name @relation(fields: [acc_schedule_name_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([acc_schedule_name_id], map: "ix_acc_schedule_line_name")
}

/// Business Central Table 133 "Financial Report" — pairs a Row Definition with a Column Layout.
model financial_report {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  description  String  @default("")
  row_group    String  @default("")
  column_group String  @default("")
  created_at   String?
  created_by   String?
}
