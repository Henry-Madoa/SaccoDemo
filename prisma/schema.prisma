model txn {
  id                 Int              @id @default(autoincrement())
  txn_ref            String           @unique
  value_date         String
  created_at         String
  module             String
  txn_type           String
  member_id          Int?
  savings_account_id Int?
  loan_id            Int?
  amount             BigInt
  running_balance    BigInt?
  channel            String?          @default("TELLER")
  description        String?
  journal_id         Int?
  created_by         String?
  status             String           @default("POSTED")
  reversal_of        Int?
  /// The specific Bank/Cashbook account this loan disbursement or repayment moved through —
  /// only set for a manual external payout/receipt (Pay Mode below); null when funded from/to a
  /// member's own savings account, where no bank account is touched at all. See
  /// lib/loanService.ts's disburse()/repay().
  bank_account_id    Int?
  /// 'CASH' | 'MPESA' | 'BANK' | 'EFT' | 'CHEQUE' — how a manual external loan disbursement/
  /// repayment was actually paid, alongside (not instead of) which bank_account received/paid it.
  pay_mode           String?
  /// Pay Mode = CHEQUE only.
