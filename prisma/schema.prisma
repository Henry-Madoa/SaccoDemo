/// The staging table an existing member's detail changes go through before member.updateMember()
/// applies them on approval — mirrors member_application's shape (every editable member field,
/// plus its own approval workflow), except member_id is required from creation: an edit always
/// targets an existing member, never null-then-filled the way an application's is.
model member_edit_request {
  no                       String                    @id
  member_id                Int
  member_type              String                    @default("INDIVIDUAL")
  member_category_id       Int?
  title                    String?
  first_name               String
  middle_name              String?
  last_name                String
  identification_no        String?
  kra_pin                  String?
  date_of_birth            String?
  gender                   String?
  marital_status           String?
  phone                    String?
  email                    String?
  postal_address           String?
  physical_address         String?
  county_id                Int?
  sub_county_id            Int?
  employer                 String?
  employment_status        String?
  staff_no                 String?
  kyc_verified             Int                       @default(0)
  join_date                String?
  photo                    String?
  front_id_image           String?
  back_id_image            String?
  signature_image          String?
  fingerprint1_image       String?
  fingerprint2_image       String?
  notes                    String?
  group_name               String?
  registration_no          String?
  registration_date        String?
  contact_person_name      String?
  contact_person_phone     String?
  contact_person_email     String?
  member_count             Int?
  global_dimension_1_id    Int?
  global_dimension_2_id    Int?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                   String                    @default("Open")
  decision_reason          String?
  created_at               String?
  created_by               String?
  processed_at             String?
