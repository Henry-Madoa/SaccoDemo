  description        String?
  journal_id         Int?
  created_by         String?
  status             String           @default("POSTED")
  reversal_of        Int?
  journal            journal?         @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan               loan?            @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member             member?          @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  txn                txn?             @relation("txnTotxn", fields: [reversal_of], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_txn          txn[]            @relation("txnTotxn")
  savings_account    savings_account? @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([value_date], map: "ix_txn_date")
  @@index([loan_id, id], map: "ix_txn_loan")
  @@index([member_id, id(sort: Desc)], map: "ix_txn_member")
  @@index([savings_account_id, id], map: "ix_txn_sa")
}

/// An admin-defined CSV export/import package (Admin Centre → Data Management), modeled on
/// Business Central's Configuration Packages: which table, and via config_package_field, which
/// of that table's columns are included — one package has many fields.
model config_package {
  id         Int                    @id @default(autoincrement())
  code       String                 @unique
  name       String
  table_name String
  key_field  String?
  created_at String?
  created_by String?
  field      config_package_field[]
}

model config_package_field {
  id         Int            @id @default(autoincrement())
  package_id Int
  field_name String
  column_no  Int
  package    config_package @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([package_id, field_name], map: "ux_config_package_field")
}
