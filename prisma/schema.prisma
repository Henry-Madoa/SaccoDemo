/// An admin-defined CSV export/import package (Admin Centre → Data Management), modeled on
/// Business Central's Configuration Packages: which table, and via config_package_field, which
/// of that table's columns are included — one package has many fields.
model config_package {
  id         Int                    @id @default(autoincrement())
  code       String                 @unique
  name       String
  table_name String
  key_field  String?
  created_at String?
  created_by String?
  field      config_package_field[]
}

model config_package_field {
  id         Int            @id @default(autoincrement())
  package_id Int
  field_name String
  column_no  Int
  package    config_package @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([package_id, field_name], map: "ux_config_package_field")
}

/**
 * Collateral Module — a SACCO member pledges a titled asset (vehicle, land, building) as
 * security for a loan above a threshold, or instead of guarantors. Four tables carry the
 * lifecycle: collateral_type (setup — LTV multiplier per category), collateral_application
 * (the maker-checker request to pledge one asset), collateral_register (the accepted,
 * read-only record of it once the application is Processed — shares its primary key with
 * the application, a 1:1 pair), and collateral_release (the maker-checker request to hand
 * it back). loan_collateral is the join between a loan and the register item(s) securing it
 * — Loan Securities' "Security Type = Collateral" rows, narrowed to just this one security
 * type since loan_guarantor already covers guarantor security separately.
 */

/// Setup: the catalogue of acceptable collateral types, each with its own loan-to-value
/// multiplier (a percentage, e.g. 70 = 70%) applied to a pledged asset's market value to
/// derive its realisable security value ("Guarantee").
model collateral_type {
  id                     Int                      @id @default(autoincrement())
  code                   String                   @unique
  description            String
  /// 'VEHICLE' | 'REAL_ESTATE'
  category               String
  value_multiplier       Float                    @default(0)
  status                 String                   @default("ACTIVE")
  collateral_application collateral_application[]
  collateral_register    collateral_register[]

  @@index([category], map: "ix_ctype_category")
}

/// The transactional document: one row per request to pledge one asset. Same
/// Open -> Pending Approval -> Approved -> Processed shape as account_opening_request —
/// processing (see lib/collateralApplications.ts's postCollateralApplication()) writes the
/// accepted asset into collateral_register under the same `no`.
model collateral_application {
  no                                String                              @id
  member_id                         Int
  category                          String
  collateral_type_id                Int?
  /// Snapshotted from collateral_type at the time it was picked — a later change to the
  /// type's own description must not retroactively change this document.
  collateral_description            String?
  /// Snapshotted LTV multiplier — see collateral_description.
  multiplier                        Float                               @default(0)
  /// Market/appraised value, minor units.
  collateral_value                  BigInt                              @default(0)
  /// = collateral_value * multiplier / 100, minor units. Always recomputed alongside
  /// collateral_value or collateral_type_id in the same service call, so it can never go
  /// stale the way the source AL implementation's field-level trigger allowed.
  guarantee                         BigInt                              @default(0)
  /// Vehicle registration / title deed number — identifies the physical asset. Checked for
  /// duplicates against the live register unless multi_linking is set.
  serial_reg_no                     String?
  /// Deliberately bypasses the duplicate serial/reg-no check — one asset pledged against
  /// several loans at once.
  multi_linking                     Int                                 @default(0)
  county_id                         Int?
  last_valuation_date               String?
  joint_ownership                   Int                                 @default(0)
  owner_name                        String?
  owner_id_no                       String?
  /// Registered owner's phone — a plain input, not derived from the member (the owner may
  /// not be the member; see Joint Ownership).
  owner_phone_no                    String?
  /// Vehicle only.
  insurance_expiry_date             String?
  car_track_due_date                String?
  cheque_no                         String?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                            String                              @default("Open")
  decision_reason                   String?
  processed_at                      String?
  processed_by                      String?
  created_at                        String?
  created_by                        String?
  member                            member                              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_type                   collateral_type?                    @relation(fields: [collateral_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  county                            county?                             @relation(fields: [county_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_application_attachment collateral_application_attachment[]
  collateral_register               collateral_register?

  @@index([member_id], map: "ix_capp_member")
  @@index([status], map: "ix_capp_status")
  @@index([serial_reg_no], map: "ix_capp_serial")
}

model collateral_application_attachment {
  id                     Int                    @id @default(autoincrement())
  application_no         String
  public_id              String                 @unique
  url                    String
  filename               String
  resource_type          String                 @default("image")
  format                 String?
  bytes                  Int                    @default(0)
  category               String?
  uploaded_at            String
  uploaded_by            String
  collateral_application collateral_application @relation(fields: [application_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([application_no], map: "ix_capp_attachment_no")
}

/// The register of accepted collateral. Shares its primary key with collateral_application —
/// one register row per Processed application (BR-14). Read-only through the UI; written only
/// by postCollateralApplication() and postCollateralRelease(). `status` (Available/Linked to
/// Loan/Collected) is deliberately not a stored column — see lib/collateralRegister.ts — it's
/// derived from whether a live loan_collateral row consumes cover and whether collected_at is
/// set, so an invalid combination can never be persisted.
model collateral_register {
  no                     String                 @id
  member_id              Int
  category               String
  collateral_type_id     Int?
  collateral_description String?
  collateral_value       BigInt                 @default(0)
  /// Captioned "LTV" in the UI — the realisable cover this item provides.
  guarantee              BigInt                 @default(0)
  serial_reg_no          String?
  posting_date           String?
  county_id              Int?
  owner_name             String?
  owner_id_no            String?
  owner_phone_no         String?
  insurance_expiry_date  String?
  car_track_due_date     String?
  /// Set once a Processed collateral_release exists against this item.
  collected_at           String?
  created_at             String?
  collateral_application collateral_application @relation(fields: [no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  member                 member                 @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_type        collateral_type?       @relation(fields: [collateral_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  county                 county?                @relation(fields: [county_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_release     collateral_release[]
  loan_collateral        loan_collateral[]
  loan_guarantor_change_replacement loan_guarantor_change_replacement[]

  @@index([member_id, collateral_type_id], map: "ix_creg_member_type")
  @@index([serial_reg_no], map: "ix_creg_serial")
}

/// A maker-checker request to hand a pledged asset back — the same Open -> Pending Approval
/// -> Approved -> Processed shape as every other request in this file. Processing (see
/// lib/collateralReleases.ts's postCollateralRelease()) stamps collateral_register.collected_at,
/// re-checking (not merely trusting the submit-time check) that the item no longer secures any
/// outstanding loan balance.
model collateral_release {
  no                  String              @id
  collateral_no       String
  member_id           Int
  collection_date     String?
  collected_by        String?
  collected_by_id_no  String?
  /// 'LOCAL' | 'DIASPORA'
  nationality         String              @default("LOCAL")
  /// Only meaningful when nationality = 'DIASPORA'.
  domicile_country    String?
  comments            String?
  remarks             String?
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status              String              @default("Open")
  decision_reason     String?
  processed_at        String?
  processed_by        String?
  created_at          String?
  created_by          String?
  collateral_register collateral_register @relation(fields: [collateral_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  member              member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([collateral_no], map: "ix_crel_collateral")
  @@index([status], map: "ix_crel_status")
}

/// The join between a loan and the collateral register item(s) securing it — "Loan Securities"
/// narrowed to Security Type = Collateral (loan_guarantor already covers guarantor security
/// separately, so this table only ever carries collateral). `guarantee` is the cover this
/// specific loan draws from the item, snapshotted at attach time and capped to the item's own
/// available cover — see lib/loanCollateral.ts.
model loan_collateral {
  id                  Int                 @id @default(autoincrement())
  loan_id             Int
  collateral_no       String
  guarantee           BigInt
  /// 'ACTIVE' | 'SUBSTITUTED' — a substituted link is excluded from cover calculations,
  /// mirroring Loan Securities.Substituted, but kept for history rather than deleted.
  status              String              @default("ACTIVE")
  created_at          String?
  created_by          String?
  loan                loan                @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collateral_register collateral_register @relation(fields: [collateral_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@unique([loan_id, collateral_no], map: "ux_loan_collateral")
  @@index([collateral_no], map: "ix_lc_collateral")
  @@index([loan_id], map: "ix_lc_loan")
}

/// Guarantor Change Management — maker-checker request to release and/or substitute guarantors
/// on an already-disbursed loan, ported from the AL reference's "Loan Security Mgmt." card
/// (Tab52204085 + Tab52204058 + Tab52204059) narrowed to Security Type = Guarantor only, since
/// collateral already has its own release lifecycle (collateral_release above). One header per
/// review, one line per guarantor currently COMMITTED to the loan at the time it was opened/last
/// refreshed, each line either released outright or covered by one or more replacement guarantors.
model loan_guarantor_change {
  no              String                       @id
  loan_id         Int
  /// The loan's own borrower, snapshotted from loan.member_id at creation.
  member_id       Int
  /// "Document Status" — the approval workflow state.
  status          String                       @default("Open")
  decision_reason String?
  processed_at    String?
  processed_by    String?
  created_at      String?
  created_by      String?
  loan            loan                         @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member          member                       @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines           loan_guarantor_change_line[]

  @@index([loan_id], map: "ix_lgc_loan")
  @@index([status], map: "ix_lgc_status")
}

/// One row per guarantor COMMITTED to the loan when this document was populated — the officer
/// marks it `release` (drop outright) or leaves it alone and attaches replacement rows instead.
model loan_guarantor_change_line {
  id                     Int                                 @id @default(autoincrement())
  change_no              String
  /// The currently-committed guarantor this line reviews.
  guarantor_member_id    Int
  /// Snapshot of loan_guarantor.amount at populate time.
  initial_guaranteed     BigInt                              @default(0)
  /// Snapshot of that guarantor's prorated exposure on this loan at populate time (same formula
  /// as lib/guarantors.ts's guaranteeSplit — capped at the loan's current outstanding balance).
  outstanding_guaranteed BigInt                              @default(0)
  release                Boolean                              @default(false)
  change                 loan_guarantor_change               @relation(fields: [change_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  guarantor_member       member                               @relation(fields: [guarantor_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacements           loan_guarantor_change_replacement[]

  @@unique([change_no, guarantor_member_id], map: "ux_lgcl_change_member")
  @@index([change_no], map: "ix_lgcl_change")
}

/// A proposed replacement covering (part of) a line's outstanding amount — AL's Det. Lines
/// (Tab52204059), one of three Security Types:
///   - GUARANTOR: another member (never the loan's own borrower — self-guarantee isn't a
///     loan_guarantor row in this schema, see lib/guarantors.ts's selfGuaranteeCapacity), vetted
///     against their own live guarantee capacity.
///   - COLLATERAL: a collateral_register item already registered to the loan's own borrower
///     (never anyone else's), vetted against its own live cover via
///     lib/collateralRegister.ts's getCollateralLinkedBalance().
///   - FIXED_DEPOSIT: a member_fixed_deposit belonging to the loan's own borrower, vetted against
///     lib/loanFdSecurity.ts's getFdLinkedBalance().
/// Processing (lib/loanGuarantorChanges.ts's processGuarantorChange()) writes a COLLATERAL/
/// FIXED_DEPOSIT replacement straight into loan_collateral/loan_fd_lien — the same tables the
/// loan card's own Attach Collateral/Attach FD Security actions use — bypassing their normal
/// "only while OPEN" gate, since an approved change document is its own authorization path onto
/// an already-DISBURSED loan.
model loan_guarantor_change_replacement {
  id                         Int                        @id @default(autoincrement())
  line_id                    Int
  replacement_type           String                     @default("GUARANTOR") // GUARANTOR | COLLATERAL | FIXED_DEPOSIT
  replacement_member_id      Int?
  replacement_collateral_no  String?
  replacement_fd_no          String?
  amount                     BigInt                     @default(0)
  line                       loan_guarantor_change_line @relation(fields: [line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacement_member         member?                    @relation(fields: [replacement_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacement_collateral     collateral_register?       @relation(fields: [replacement_collateral_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  replacement_fd             member_fixed_deposit?      @relation(fields: [replacement_fd_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([line_id], map: "ix_lgcr_line")
  @@index([replacement_collateral_no], map: "ix_lgcr_collateral")
  @@index([replacement_fd_no], map: "ix_lgcr_fd")
}

/// Member Exit Module — the maker-checker process for terminating a membership, ported from the
/// AL reference's "Member Withdrawal" table (Tab52204055) narrowed to Document Type = Withdrawal
/// only (the sibling "Refund" variant on the same AL table is a partial-withdrawal-without-exit
/// feature of its own, out of scope here). Settles everything the member owns against everything
/// they owe (see lib/memberExits.ts's processMemberExit()), pays out the difference, and closes
/// their accounts.
model member_exit {
  no                    String             @id
  member_id             Int
  /// 'GENERAL' | 'RETIREE' | 'DECEASED' — AL's "Withdrawal Type". DECEASED skips the
  /// loan/guarantee liability checks (an estate isn't blocked on clearing loans first).
  exit_type             String             @default("GENERAL")
  /// 'FOSA' | 'BANK_TRANSFER' — AL's "Balance Option", which channel the final payout uses.
  payout_method         String             @default("FOSA")
  reason                String?
  /// AL's "Charge Code" — optional, posted via lib/charges.ts's postTransactionCharges() at
  /// processing time.
  transaction_charge_id Int?
  /// AL's "Instant" field (Tab52204055) — checking it auto-populates transaction_charge_id
  /// from organisation.instant_withdrawal_charge_id and, per AL's own
  /// MemberWithdrawalNotifications() filter (which excludes Instant records from the
  /// mature-for-posting reminder), also lets processMemberExit() skip the maturity wait.
  is_instant            Boolean            @default(false)
  exit_date             String?
  /// exit_date + organisation.member_exit_notice_days — processMemberExit() refuses to run
  /// before this date, same as AL's own maturity check.
  maturity_date         String?
  /// Snapshotted by populateLines()/refreshMemberExitLines() — total_assets (excl. share
  /// capital) + liabilities. Guarantees deliberately excluded, same as AL's own Net Amount.
  net_amount            BigInt             @default(0)
  /// The exit charge actually posted at processing time (loan.fees_charged's own precedent) —
  /// kept separately from net_amount rather than netted into it there, since net_amount also
  /// gates the "liabilities exceed assets" solvency check before a charge is even known. Zero
  /// until processed; the UI computes a live estimate before then.
  charge_amount         BigInt             @default(0)
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                String             @default("Open")
  decision_reason       String?
  processed_at          String?
  processed_by          String?
  created_at            String?
  created_by            String?
  member                member             @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines                 member_exit_line[]

  @@index([member_id], map: "ix_mex_member")
  @@index([status], map: "ix_mex_status")
}

/// One asset/liability/guarantee line snapshotted when the exit was opened or last refreshed.
/// Unlike AL's free-text "Account No", this carries real FKs into savings_account/loan — this
/// schema already has ids for both, so the card can link straight to the source record.
model member_exit_line {
  id                 Int              @id @default(autoincrement())
  exit_no            String
  /// 'ASSET' | 'LIABILITY' | 'GUARANTEE'
  entry_type         String
  /// Set for ASSET lines.
  savings_account_id Int?
  /// Set for LIABILITY (this member's own loan) and GUARANTEE (a loan this member guarantees
  /// for someone else) lines.
  loan_id            Int?
  account_name       String?
  balance            BigInt           @default(0)
  /// Signed: positive for an asset, negative for a liability or guarantee.
  amount             BigInt           @default(0)
  /// Share capital is captured for visibility but excluded from net_amount and never
  /// transferred/paid out during processing — matches AL's own Total Assets flowfield and
  /// posting loop, both of which explicitly exclude it.
  is_share_capital   Boolean          @default(false)
  exit               member_exit      @relation(fields: [exit_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  savings_account    savings_account? @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan               loan?            @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exit_no], map: "ix_mexl_exit")
}

/// Checkoff and Salary Processing — the employer master, ported from the AL reference's
/// "Employers" table (Tab52204126) narrowed to what routes a checkoff/salary batch: name/contact,
/// whether a payroll number is mandatory for its members, and status. The 59-file AL module this
/// narrows (Checkoff Upload/Calculation reconciliation ledgers, Standing Orders, Checkoff
/// Variations, Checkoff Advice, Employer Payroll Details staging, several analysis reports) is
/// scoped down in lib/checkoffBatches.ts's own header comment.
model employer {
  id                   Int              @id @default(autoincrement())
  code                 String           @unique
  name                 String
  phone                String?
  email                String?
  payroll_no_mandatory Boolean          @default(false)
  status               String           @default("ACTIVE")
  member               member[]
  checkoff_batch       checkoff_batch[]
}

/// A maker-checker batch document scoped to one employer/period: CHECKOFF lines compute each
/// member's expected loan-installment recovery and record what was actually remitted (the
/// reconciliation step), SALARY lines simply record each member's remitted net salary — see
/// lib/checkoffBatches.ts's processCheckoffBatch() for how each type posts.
model checkoff_batch {
  no                    String                 @id
  /// 'CHECKOFF' | 'SALARY'
  batch_type            String
  employer_id           Int
  /// First-of-month, e.g. '2026-08-01' — the payroll period this batch covers.
  period                String
  posting_date          String?
  description           String?
  /// 'MEMBER_NO' | 'ID_NUMBER' | 'PAYROLL_NO' | 'FOSA_NUMBER' — which column of an uploaded CSV
  /// identifies each row's member, and how it's resolved. Ported from the AL reference's
  /// "CheckOff Search Type" enum (Enum52204034), dropping its "Old FOSA Number" value — this
  /// port has no legacy-FOSA-number concept to search on. See applyCheckoffCsvUpload().
  search_type           String                 @default("PAYROLL_NO")
  /// "Document Status" — the approval workflow state. Captioned "Status" in the UI.
  status                String                 @default("Open")
  decision_reason       String?
  /// SALARY only — the 'End Month Salary' Transaction Charge whose components (charges) and
  /// Transaction Recoveries (loan/internal-deposit waterfall) Calculate applies against each
  /// line's remitted amount. Null means Calculate has nothing configured to run.
  transaction_charge_id Int?
  processed_at          String?
  processed_by          String?
  created_at            String?
  created_by            String?
  employer              employer               @relation(fields: [employer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge?    @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines                 checkoff_batch_line[]
  calculations          checkoff_calculation[]

  @@index([employer_id], map: "ix_cob_employer")
  @@index([status], map: "ix_cob_status")
}

/// One member's line within a checkoff/salary batch.
model checkoff_batch_line {
  id              Int                    @id @default(autoincrement())
  batch_no        String
  member_id       Int
  payroll_no      String?
  /// CHECKOFF only — sum of this member's recovery_mode='CHECKOFF' disbursed loan installments,
  /// each capped at that loan's own outstanding balance. Always 0 for a SALARY line (this port
  /// excludes AL's Employer Payroll Details staging table, so there is nothing to compute an
  /// expected salary from — the officer records the actual remitted amount directly instead).
  expected_amount BigInt                 @default(0)
  /// What the officer records as actually remitted for this member — the reconciliation input
  /// both batch types share. A CSV upload that matches this line overwrites it with
  /// uploaded_amount.
  remitted_amount BigInt                 @default(0)
  /// remitted_amount - expected_amount (CHECKOFF only; always 0 for SALARY).
  variance        BigInt                 @default(0)
  /// The amount the last CSV upload carried for this member (0 if never uploaded or unmatched).
  uploaded_amount BigInt                 @default(0)
  /// The name column from the last CSV upload row that matched this line — kept for the officer
  /// to eyeball against the member's own name, since matching itself is by payroll/staff no.
  uploaded_name   String?
  /// False when the last CSV upload had a row that could not be matched to any line by payroll
  /// no — surfaced so "tally what is uploaded vs. what the card shows" has something to flag.
  matched         Boolean                @default(true)
  batch           checkoff_batch         @relation(fields: [batch_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  member          member                 @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calculations    checkoff_calculation[]

  @@unique([batch_no, member_id], map: "ux_cobl_batch_member")
}

/// One priority-ordered recovery rule attached to an 'End Month Salary' Transaction Charge —
/// ported from the AL reference's Tab52204065 "Transaction Recoveries", narrowed to the three
/// recovery types this app can actually act on without further master data: recovering a
/// member's own payroll-deducted loans, sweeping/topping-up one of their savings accounts, or
/// recovering their own salary_based Standing Order(s) directly (see standing_order.salary_based).
model transaction_recovery {
  id                    Int                @id @default(autoincrement())
  transaction_charge_id Int
  /// 'LOAN' | 'STANDING_ORDER' | 'INTERNAL_DEPOSIT'
  recovery_type         String
  /// LOAN: 'INSTALLMENT' | 'ARREARS' | 'BALANCE'. INTERNAL_DEPOSIT: 'FULL_REMAINING' |
  /// 'BOOST_TO_MINIMUM'. STANDING_ORDER: unused (null) — a standing order's own Amount Type
  /// (Fixed/Sweep) already decides how much it recovers.
  deduction_type        String?
  /// Required, INTERNAL_DEPOSIT only — which savings product's account to recover into.
  savings_product_id    Int?
  /// STANDING_ORDER only — matches a member's own salary_based, running standing order(s)
  /// directly by class (INTERNAL | EXTERNAL | LOAN); null matches any class. The standing order
  /// itself already carries every other instruction (amount, destination, charge) needed to
  /// recover it, so no separate type tag is kept here — configuring multiple STANDING_ORDER
  /// recoveries, each pinned to a different class with its own priority, is how "priority per
  /// class" is achieved — there is no separate per-class priority field, since Transaction
  /// Recoveries already orders by row.
  standing_order_class  String?
  priority              Int                @default(1)
  description           String?
  status                String             @default("ACTIVE")
  transaction_charge    transaction_charge @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_product       savings_product?   @relation(fields: [savings_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([transaction_charge_id], map: "ix_trec_tc")
}

/// One line of a Calculate run's breakdown for one checkoff_batch_line — a Transaction Charge
/// component, a Transaction Recovery deduction, or the net amount left over — kept for the
/// officer to review before Send for approval, and for processCheckoffBatch() to post from
/// (rather than recomputing at process time, so what was approved is exactly what posts).
model checkoff_calculation {
  id                 Int                 @id @default(autoincrement())
  batch_no           String
  line_id            Int
  /// 'CHARGE' | 'LOAN_RECOVERY' | 'STANDING_ORDER' | 'INTERNAL_DEPOSIT' | 'NET_AMOUNT'
  entry_type         String
  description        String
  loan_id            Int?
  savings_account_id Int?
  gl_account_id      Int?
  /// STANDING_ORDER only — processCheckoffBatch() re-derives the order's own destination and
  /// Charge Code from this at posting time rather than storing them separately.
  standing_order_no  String?
  amount             BigInt              @default(0)
  batch              checkoff_batch      @relation(fields: [batch_no], references: [no], onDelete: NoAction, onUpdate: NoAction)
  line               checkoff_batch_line @relation(fields: [line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  standing_order     standing_order?     @relation(fields: [standing_order_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([batch_no], map: "ix_cocalc_batch")
  @@index([line_id], map: "ix_cocalc_line")
  @@index([standing_order_no], map: "ix_cocalc_sto")
}

/// System Automation (Job Queue) — mirrors Business Central's Job Queue Entry: a recurring
/// background task, dispatched by job_type (see lib/jobQueue.ts's JOB_HANDLERS), that an admin
/// sets up and the in-process scheduler (instrumentation.ts) polls and runs unattended. AL's own
/// Recurrence (Day/Time-of-day patterns) is simplified to a plain "every N minutes" interval —
/// the same kind of simplification organisation.member_exit_notice_days already applies to a
/// DateFormula elsewhere in this port.
model job_queue_entry {
  id                Int     @id @default(autoincrement())
  code              String  @unique
  description       String
  /// Which background task this entry runs — see lib/jobQueue.ts's JOB_HANDLERS. Currently only
  /// 'ENTRANCE_FEE_RECOVERY' is implemented.
  job_type          String
  run_every_minutes Int     @default(60)
  /// The job never runs before this date, even if otherwise due — an optional go-live gate.
  earliest_start_date String?
  /// 'READY' | 'ON HOLD' — the two states an entry idles in between runs. A failed run does not
  /// flip this to some third "Error" state and stop recurring: it stays READY and simply carries
  /// the failure on last_run_status/last_run_message, so an admin can see and fix the underlying
  /// cause without also having to remember to re-enable the entry.
  status            String  @default("ON HOLD")
  next_run_at       String?
  last_run_at       String?
  /// 'SUCCESS' | 'ERROR'
  last_run_status   String?
  last_run_message  String?
  created_at        String?
  created_by        String?
  updated_at        String?
  updated_by        String?

  @@index([status], map: "ix_jqe_status")
}

/// FOSA cash-denomination master — AL "Denominations Setup" (Tab under Codeunit 52204019's
/// ValidateTransactionDenominations). One row per note/coin; `value` is in cents.
model denomination {
  id                     Int                      @id @default(autoincrement())
  code                   String                   @unique
  description            String
  value                  BigInt
  active                 Boolean                  @default(true)
  sort_order             Int                      @default(0)
  cash_denomination_line cash_denomination_line[]
}

/// The per-document denomination breakdown — AL "Transaction Denomination" (Tab52204045), one
/// shared table keyed by a document-kind discriminator ('FOSA' | 'TELLER') exactly as AL keys
/// its rows by the "FOSA Transaction Types" enum (which includes "Teller Transactions").
model cash_denomination_line {
  id             Int          @id @default(autoincrement())
  document_kind  String
  document_no    String
  denomination_id Int
  quantity       Int          @default(0)
  denomination   denomination @relation(fields: [denomination_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([document_kind, document_no, denomination_id])
  @@index([document_kind, document_no], map: "ix_cdl_document")
}

/// AL "Teller Setup" (Tab52204042) — links a user to the cash account they operate: a TELLER to
/// their own till (bank_account.account_type = 'TILL'), or a TREASURY user to the branch vault
/// (account_type = 'TREASURY'). Capacity limits gate fosa_transaction posting; approval_limit
/// gates whether a teller_transaction auto-posts or must be approved first.
model teller_setup {
  id             Int          @id @default(autoincrement())
  user_username  String
  setup_type     String
  bank_account_id Int
  max_capacity   BigInt       @default(0)
  min_capacity   BigInt       @default(0)
  approval_limit BigInt       @default(0)
  created_at     String?
  created_by     String?
  bank_account   bank_account @relation(fields: [bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_username, setup_type])
  @@index([bank_account_id], map: "ix_ts_bank_account")
}

/// AL "FOSA Transactions" (Tab52204044) — the five treasury/till cash movements, one table with
/// a `document_type` discriminator: RECEIVE_FROM_BANK (Main Bank -> Treasury), TREASURY_REQUEST
/// (Treasury -> Till), INTER_TILL (Till -> Till), TREASURY_RETURN (Till -> Treasury),
/// SEND_TO_BANK (Treasury -> Main Bank). Maker-checker: Open -> Pending Approval -> Approved ->
/// Processed. Posting (lib/cashManagement.ts) is one balanced journal debiting the source bank
/// account's control G/L and crediting the destination's — postJournal() then maintains both
/// bank_account balances and the reconciliation subledger automatically.
model fosa_transaction {
  no                          String       @id
  document_type               String
  source_bank_account_id      Int
  destination_bank_account_id Int
  amount                      BigInt       @default(0)
  status                      String       @default("Open")
  decision_reason             String?
  posted                      Boolean      @default(false)
  journal_id                  Int?
  global_dimension_1_id       Int?
  global_dimension_2_id       Int?
  created_at                  String?
  created_by                  String?
  posted_at                   String?
  posted_by                   String?
  source_bank_account         bank_account @relation("ft_source", fields: [source_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_bank_account    bank_account @relation("ft_destination", fields: [destination_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal                     journal?     @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([document_type, status], map: "ix_ft_type_status")
  @@index([created_by], map: "ix_ft_created_by")
}

/// AL "Teller Transactions" (Tab52204046) — an over-the-counter member cash deposit or
/// withdrawal posted against the teller's own till. Auto-posts when the amount is within the
/// teller's Approval Limit (and the member is not staff); otherwise routes through maker-checker
/// approval first. Posting (lib/tellerTransactions.ts) debits/credits the till cash G/L against
/// the member's withdrawable-deposit control G/L, plus a configurable transaction charge.
model teller_transaction {
  no                    String              @id
  transaction_type      String
  member_id             Int
  savings_account_id    Int
  till_bank_account_id  Int
  teller_username       String
  amount                BigInt
  source_of_funds       String?
  transacted_by_name    String?
  transacted_by_id_no   String?
  transaction_charge_id Int?
  charge_amount         BigInt              @default(0)
  available_balance     BigInt              @default(0)
  book_balance          BigInt              @default(0)
  approval_required     Boolean             @default(false)
  status                String              @default("Open")
  decision_reason       String?
  posted                Boolean             @default(false)
  journal_id            Int?
  slip_emailed_at       String?
  global_dimension_1_id Int?
  global_dimension_2_id Int?
  created_at            String?
  created_by            String?
  posted_at             String?
  posted_by             String?
  member                member              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account       savings_account     @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  till_bank_account     bank_account        @relation(fields: [till_bank_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journal               journal?            @relation(fields: [journal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([transaction_type, status], map: "ix_tt_type_status")
  @@index([member_id], map: "ix_tt_member")
  @@index([created_by], map: "ix_tt_created_by")
}

/// AL "Lien" (Tab52204192 / Pages 52204235-6 / Cod52204007.PostAmountHolding). A maker-checker
/// instruction to place a HOLD on part of a member's deposit-account balance (making it
/// unavailable to withdraw / borrow against / sweep) or to RELEASE a previous hold. There is no
/// G/L posting — processing just moves savings_account.hold_amount, which every "available
/// balance" calculation in the app already subtracts (AL's "Uncleared Funds"). Lifecycle:
/// Open -> Pending Approval -> Approved -> Processed, with a Reopen back to Open while Approved
/// and not yet processed.
model member_lien {
  no                    String          @id
  member_id             Int
  savings_account_id    Int
  /// 'HOLD' | 'RELEASE'
  transaction_type      String
  amount                BigInt          @default(0)
  narration             String?
  posting_date          String
  status                String          @default("Open")
  decision_reason       String?
  processed             Boolean         @default(false)
  global_dimension_1_id Int?
  global_dimension_2_id Int?
  created_at            String?
  created_by            String?
  processed_at          String?
  processed_by          String?
  member                member          @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account       savings_account @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_lien_member")
  @@index([savings_account_id], map: "ix_lien_account")
  @@index([transaction_type, status], map: "ix_lien_type_status")
  @@index([created_by], map: "ix_lien_created_by")
}

/// Inter Account Transfer — AL Tab52204093 / Cod52204019.PostInterAccountTransfer. A maker-checker
/// instruction to move cash between two member deposit accounts (same member's other account, or a
/// different member's account when the creator holds the cross-member right). Only products
/// flagged `savings_product.allow_transfer` (AL's "Cash Transfer Allowed") can be the source.
/// Posting withdraws `amount` from the source, deposits it to the destination and deducts a
/// configurable transfer charge (organisation.inter_account_transfer_charge_id) from the source.
model inter_account_transfer {
  no                     String          @id
  source_member_id       Int
  source_account_id      Int
  destination_member_id  Int
  destination_account_id Int
  /// PARTIAL keeps the source above its product minimum balance; FULL may drain it to zero.
  amount_type            String          @default("PARTIAL")
  amount                 BigInt          @default(0)
  transaction_charge_id  Int?
  charge_amount          BigInt          @default(0)
  narration              String?
  posting_date           String
  status                 String          @default("Open")
  decision_reason        String?
  posted                 Boolean         @default(false)
  journal_id             Int?
  global_dimension_1_id  Int?
  global_dimension_2_id  Int?
  created_at             String?
  created_by             String?
  posted_at             String?
  posted_by             String?
  source_member          member          @relation("iat_source_member", fields: [source_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_member     member          @relation("iat_destination_member", fields: [destination_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_account         savings_account @relation("iat_source_account", fields: [source_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destination_account    savings_account @relation("iat_destination_account", fields: [destination_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge     transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([source_member_id], map: "ix_iat_source_member")
  @@index([destination_member_id], map: "ix_iat_dest_member")
  @@index([source_account_id], map: "ix_iat_source_account")
  @@index([status], map: "ix_iat_status")
  @@index([created_by], map: "ix_iat_created_by")
}

/// Cheque Types master — AL Tab52204122 (only the "Bankers Cheque" type is ported). One row per
/// kind of banker's cheque the SACCO sells: its ceiling, the clearing G/L account the issued
/// cheque is credited to, and the clearing charge deducted from the member.
model cheque_type {
  id                     Int                @id @default(autoincrement())
  code                   String             @unique
  /// 'BANKERS' (lib/bankersCheques.ts) | 'EXTERNAL' (lib/chequeDeposits.ts) — AL Cheque Type enum.
  type                   String             @default("BANKERS")
  description            String
  maximum_amount         BigInt             @default(0)
  clearing_gl_account_id Int
  clearing_charge_id     Int?
  bouncing_charge_id     Int?
  express_charge_id      Int?
  in_house               Boolean            @default(false)
  /// AL "Maturity Period" (DateFormula) collapsed to a plain calendar-day count.
  maturity_days          Int                @default(3)
  status                 String             @default("ACTIVE")
  created_at             String?
  created_by             String?
  clearing_gl_account    gl_account         @relation(fields: [clearing_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clearing_charge        transaction_charge? @relation("ct_clearing_charge", fields: [clearing_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bouncing_charge        transaction_charge? @relation("ct_bouncing_charge", fields: [bouncing_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  express_charge         transaction_charge? @relation("ct_express_charge", fields: [express_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bankers_cheque         bankers_cheque[]
  cheque_deposit         cheque_deposit[]
}

/// Cheque Deposit — AL Tab52204124. A member banks a third-party cheque; it clears to their
/// account on its maturity date (clearing charge), or bounces (bouncing charge), or is
/// express-cleared before maturity (express charge + a hold on the account until the real
/// maturity date). Lifecycle Open -> Pending Approval -> Approved -> Cleared | Bounced.
model cheque_deposit {
  no                     String             @id
  cheque_type_id         Int
  description            String?
  member_id              Int
  savings_account_id     Int
  cheque_no              String?
  cheque_date            String?
  deposit_date           String
  maturity_date          String
  in_house               Boolean            @default(false)
  amount                 BigInt             @default(0)
  express_cheque         Boolean            @default(false)
  drawer_account_name    String?
  drawer_bank            String?
  drawer_branch          String?
  drawer_account_no      String?
  clearing_gl_account_id Int
  clearing_charge_id     Int?
  bouncing_charge_id     Int?
  express_charge_id      Int?
  /// The charge actually taken on clearing / bouncing (recomputed at post time).
  charge_amount          BigInt             @default(0)
  /// Amount currently held on the account from an express clearance (0 once released at maturity).
  express_hold_amount    BigInt             @default(0)
  status                 String             @default("Open")
  decision_reason        String?
  cleared_by             String?
  clearance_date         String?
  journal_id             Int?
  global_dimension_1_id  Int?
  global_dimension_2_id  Int?
  created_at             String?
  created_by             String?
  cheque_type            cheque_type        @relation(fields: [cheque_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member                 member             @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account        savings_account    @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clearing_gl_account    gl_account         @relation("cd_clearing_gl_account", fields: [clearing_gl_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clearing_charge        transaction_charge? @relation("cd_clearing_charge", fields: [clearing_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cheque_instruction     cheque_instruction[]

  @@index([member_id], map: "ix_cd_member")
  @@index([savings_account_id], map: "ix_cd_account")
  @@index([status], map: "ix_cd_status")
  @@index([created_by], map: "ix_cd_created_by")
  @@index([maturity_date], map: "ix_cd_maturity")
}

/// Cheque Instructions — AL Tab52204087. When a cheque deposit clears, move part of the funds
/// from the deposit account to another of the same member's savings accounts, and/or apply it to
/// one of their disbursed loans. Executed when the funds are confirmed (normal clearing, or
/// when an express clearance's hold is released at maturity).
model cheque_instruction {
  id                Int             @id @default(autoincrement())
  cheque_deposit_no String
  line_no           Int             @default(0)
  /// 'ACCOUNT' | 'LOAN'
  target_type       String          @default("ACCOUNT")
  savings_account_id Int?
  loan_id           Int?
  amount            BigInt          @default(0)
  created_at        String?
  created_by        String?
  cheque_deposit    cheque_deposit  @relation(fields: [cheque_deposit_no], references: [no], onDelete: Cascade, onUpdate: NoAction)
  savings_account   savings_account? @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan              loan?           @relation(fields: [loan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cheque_deposit_no], map: "ix_ci_deposit")
}

/// Bankers Cheque — AL Tab52204123. A maker-checker sale of a banker's cheque against a member's
/// deposit account: on posting the member's account is debited `amount` (+ clearing charge) and
/// the cheque type's clearing G/L account is credited `amount`. Lifecycle Open -> Pending
/// Approval -> Approved -> Processed, same shape as lib/liens.ts / lib/interAccountTransfer.ts.
model bankers_cheque {
  no                    String             @id
  cheque_type_id        Int
  /// Snapshot of the cheque type's description / ceiling at capture time.
  description           String?
  max_amount            BigInt             @default(0)
  member_id             Int
  savings_account_id    Int
  payee_details         String?
  /// The physical cheque leaf number entered by the teller.
  cheque_no             String?
  book_balance          BigInt             @default(0)
  amount                BigInt             @default(0)
  transaction_charge_id Int?
  charge_amount         BigInt             @default(0)
  net_amount            BigInt             @default(0)
  posting_date          String
  status                String             @default("Open")
  decision_reason       String?
  posted                Boolean            @default(false)
  journal_id            Int?
  global_dimension_1_id Int?
  global_dimension_2_id Int?
  created_at            String?
  created_by            String?
  posted_at            String?
  posted_by            String?
  cheque_type           cheque_type        @relation(fields: [cheque_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member                member             @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_account       savings_account    @relation(fields: [savings_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction_charge    transaction_charge? @relation(fields: [transaction_charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id], map: "ix_bcq_member")
  @@index([savings_account_id], map: "ix_bcq_account")
  @@index([status], map: "ix_bcq_status")
  @@index([created_by], map: "ix_bcq_created_by")
  @@index([posting_date], map: "ix_bcq_posting_date")
}
