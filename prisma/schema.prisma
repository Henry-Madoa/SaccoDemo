generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model accounting_period {
  id         Int    @id @default(autoincrement())
  code       String @unique
  start_date String
  end_date   String
  status     String @default("OPEN")
}

model app_user {
  id                         Int                          @id @default(autoincrement())
  username                   String                       @unique
  full_name                  String
  email                      String?
  phone                      String?
  password_hash              String
  role_id                    Int
  status                     String                       @default("ACTIVE")
  last_login_at              String?
  created_at                 String?
  /// BC-style "Work Date" (My Settings) — the date this user's own new documents suggest instead
  /// of the real system date, self-service via the My Settings page (lib/postingDates.ts's
  /// getWorkDate()). Must fall within this user's own effective Allow Posting range
  /// (approval_user_setup's own dates, falling back to organisation's) — validated on save, not
  /// enforced again on every read, so an admin narrowing the range after the fact doesn't need to
  /// silently invalidate an already-saved Work Date; the next save re-validates it.
  work_date                  String?
  /// The Role Centre landing page this user currently sees (My Settings → Role Centre). Points at
  /// one of the `user_profile` rows below; null falls back to the default (Super) profile. Grants
  /// no permissions — purely which dashboard `/dashboard` renders. See lib/profiles.ts.
  active_profile_id          Int?
  role                       role                         @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  active_profile             profile?                     @relation("app_user_active_profile", fields: [active_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  session                    session[]
  approval_user_setup        approval_user_setup?
  workflow_user_group_member workflow_user_group_member[]
  user_profile               user_profile[]
  user_permission_line       user_permission_line[]
  user_permission_set        user_permission_set[]

  @@index([role_id], map: "ix_user_role")
}

/// A Business Central-style Profile: a landing-page selector. Decides which Role Centre (tailored
/// home dashboard) a user sees and nothing else — it carries no permissions. Admin assigns one or
/// more to a user (user_profile); the user switches the active one from My Settings.
model profile {
  id           Int            @id @default(autoincrement())
  code         String         @unique
  name         String
  description  String         @default("")
  /// The Role Centre this profile lands on — equals `code` for the six seeded profiles.
  role_centre  String         @default("SUPER")
  icon         String         @default("")
  sort         Int            @default(0)
  /// The fallback centre when a user has profiles but no active one chosen.
  is_default   Int            @default(0)
  /// A seeded system profile — its code and role_centre are locked in the admin UI.
  is_system    Int            @default(0)
  created_at   String?
  created_by   String?
  user_profile user_profile[]
  active_for   app_user[]     @relation("app_user_active_profile")
}

/// Which Profiles an admin has assigned to a user. Many-to-many between app_user and profile.
model user_profile {
  id         Int      @id @default(autoincrement())
  user_id    Int
  profile_id Int
  user       app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile    profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, profile_id])
  @@index([user_id], map: "ix_user_profile_user")
}

model workflow {
  id                 Int                  @id @default(autoincrement())
  name               String
  document_type      String
  enabled            Int                  @default(1)
  created_at         String?
  created_by         String?
  workflow_condition workflow_condition[]
  workflow_step      workflow_step[]
  workflow_task      workflow_task[]

  @@index([document_type, enabled], map: "ix_workflow_doctype")
}

model workflow_condition {
  id          Int      @id @default(autoincrement())
  workflow_id Int
  field       String
  operator    String
  value       String
  value2      String?
  workflow    workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflow_id], map: "ix_condition_workflow")
}

model workflow_step {
  id                Int             @id @default(autoincrement())
  workflow_id       Int
  step_no           Int
  approver_type     String
  approver_user_id  Int?
  approver_group_id Int?
  notify_email      Int             @default(1)
  workflow          workflow        @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflow_task     workflow_task[]

  @@index([workflow_id, step_no], map: "ix_step_workflow")
}

/// Registers the one table backing a document type's workflow conditions (admin-managed
/// under Admin Centre → Workflow Management → Table Relations), and via
/// workflow_table_relation_field, which of that table's columns are enabled as condition
/// fields — one table relation has many fields.
model workflow_table_relation {
  id            Int                             @id @default(autoincrement())
  document_type String                          @unique
  table_name    String
  created_at    String?
  created_by    String?
  field         workflow_table_relation_field[]
}

model workflow_table_relation_field {
  id                Int                     @id @default(autoincrement())
  table_relation_id Int
  field_name        String
  table_relation    workflow_table_relation @relation(fields: [table_relation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([table_relation_id, field_name], map: "ux_table_relation_field")
}

model workflow_user_group {
  id            Int                          @id @default(autoincrement())
  name          String                       @unique
  status        String                       @default("ACTIVE")
  member        workflow_user_group_member[]
  workflow_task workflow_task[]
}

/// Members approve in ascending sequence order — any member who approves at the
/// current (lowest pending) sequence clears that level for the rest of that level
/// and moves the task on to the next one. Members sharing a sequence are alternates.
model workflow_user_group_member {
  id       Int                 @id @default(autoincrement())
  group_id Int
  user_id  Int
  sequence Int                 @default(1)
  group    workflow_user_group @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     app_user            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, user_id], map: "ux_group_member")
}

/// BC-style "User Setup": who approves this user's requests, their substitute, whether they're a
/// fallback "approval administrator" when no approver resolves, and (allow_posting_* below) this
/// user's own override of organisation.allow_posting_from/to — blank falls back to the org's
/// global range, exactly as BC's own User Setup falls back to General Ledger Setup.
model approval_user_setup {
  id                        Int      @id @default(autoincrement())
  user_id                   Int      @unique
  approver_id               Int?
  substitute_id             Int?
  is_approval_administrator Int      @default(0)
  can_reverse_journal       Int      @default(0)
  /// This user's own Allow Posting From/To dates — null leaves the corresponding organisation
  /// column in force for this user. See lib/postingDates.ts's getEffectivePostingRange().
  allow_posting_from        String?
  allow_posting_to          String?
  /// Time-of-day refinement on the two boundary dates only (BC has no stock equivalent — this
  /// port's own addition): a posting dated exactly allow_posting_from must be at/after this time
  /// of day (real wall-clock, not the posting date's own — dates carry no time in this schema);
  /// dated exactly allow_posting_to, at/before it. Dates strictly between the two boundaries are
  /// never time-restricted. Null on either side leaves that boundary's whole day unrestricted.
  allow_posting_from_time   String?
  allow_posting_to_time     String?
  user                      app_user @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_approval_administrator], map: "ix_approval_admin")
}

/// One pending or decided step of an in-flight workflow, against any document type.
/// workflow_id/workflow_step_id are null for a "legacy" task — no admin-defined
/// workflow matched, so it's decided by the document's static permission check
/// (e.g. LOAN:APPROVE) rather than a specific assignee, exactly as before this
/// module existed.
model workflow_task {
  id                   Int                  @id @default(autoincrement())
  workflow_id          Int?
  workflow_step_id     Int?
  step_no              Int
  document_type        String
  entity_id            String
  assigned_to_user_id  Int?
  assigned_to_group_id Int?
  /// Which sequence level of a group-assigned task is currently pending — null for
  /// a task assigned to a single user. Advances within this same row as members at
  /// each level approve, before the task's step itself ever moves on.
  current_sequence     Int?
  /// Set when the current approver hands this task off: delegated_by loses
  /// eligibility, delegated_to gains it, until the task is decided or (for a
  /// sequenced group) its level advances and the delegation is cleared.
  delegated_by_user_id Int?
  delegated_to_user_id Int?
  status               String               @default("PENDING")
  requested_by         String
  requested_at         String
  decided_by           String?
  decided_at           String?
  comment              String?
  amount               BigInt               @default(0)
  payload              String?
  workflow             workflow?            @relation(fields: [workflow_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workflow_step        workflow_step?       @relation(fields: [workflow_step_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workflow_user_group  workflow_user_group? @relation(fields: [assigned_to_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "ix_task_status")
  @@index([document_type, entity_id], map: "ix_task_document")
  @@index([assigned_to_user_id], map: "ix_task_assignee")
}

model notification {
  id         Int     @id @default(autoincrement())
  user_id    Int
  type       String
  title      String
  body       String?
  link       String?
  is_read    Int     @default(0)
  created_at String

  @@index([user_id, is_read], map: "ix_notification_user")
}

model attachment {
  id            Int     @id @default(autoincrement())
  entity        String
  entity_id     Int
  public_id     String  @unique
  url           String
  filename      String
  resource_type String  @default("image")
  format        String?
  bytes         Int     @default(0)
  category      String?
  uploaded_at   String
  uploaded_by   String

  @@index([entity, entity_id, id(sort: Desc)], map: "ix_attachment_entity")
}

model audit_log {
  id        Int     @id @default(autoincrement())
  at        String
  user_id   Int?
  username  String?
  action    String
  entity    String?
  entity_id String?
  detail    String?
  ip        String?

  @@index([at(sort: Desc)], map: "ix_audit_at")
}

/// Which tables get field-level change tracking — mirrors Business Central's Change Log
/// Setup: nothing is logged for a table until an admin opts it into Insertion/Modification/
/// Deletion here. Rows are seeded by migration, not created at runtime.
model change_log_setup {
  table_name       String @id
  table_caption    String
  log_insertion    Int    @default(0)
  log_modification Int    @default(0)
  log_deletion     Int    @default(0)
}

/// One row per changed field, written only for a table/change-type enabled in
/// change_log_setup — mirrors Business Central's Change Log Entries.
model change_log_entry {
  id            Int     @id @default(autoincrement())
  table_name    String
  table_caption String
  record_id     String
  field_name    String
  old_value     String?
  new_value     String?
  type          String
  changed_at    String
  user_id       Int?
  username      String

  @@index([table_name, record_id], map: "ix_change_log_entry_record")
  @@index([changed_at(sort: Desc)], map: "ix_change_log_entry_at")
}

model county {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique
  status                 String                   @default("ACTIVE")
  sub_county             sub_county[]
  member                 member[]
  member_application     member_application[]
  member_edit_request    member_edit_request[]
  collateral_application collateral_application[]
  collateral_register    collateral_register[]
}

model global_dimension_1_value {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique
  name                String                @unique
  status              String                @default("ACTIVE")
  member              member[]
  member_application  member_application[]
  member_edit_request member_edit_request[]
  journal             journal[]
  journal_line        journal_line[]
  fixed_asset         fixed_asset[]
}

model global_dimension_2_value {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique
  name                String                @unique
  status              String                @default("ACTIVE")
  member              member[]
  member_application  member_application[]
  member_edit_request member_edit_request[]
  journal             journal[]
  journal_line        journal_line[]
  fixed_asset         fixed_asset[]
}

model sub_county {
  id                  Int                   @id @default(autoincrement())
  county_id           Int
  name                String
  status              String                @default("ACTIVE")
  county              county                @relation(fields: [county_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member              member[]
  member_application  member_application[]
  member_edit_request member_edit_request[]

  @@unique([county_id, name])
  @@index([county_id], map: "ix_sub_county_county")
}

model gl_account {
  id                                                             Int                         @id @default(autoincrement())
  code                                                           String                      @unique
  name                                                           String
  type                                                           String
  parent_code                                                    String?
  is_postable                                                    Int                         @default(1)
  account_type                                                   String                      @default("POSTING")
  totaling                                                       String?
  balance                                                        BigInt                      @default(0)
  status                                                         String                      @default("ACTIVE")
  /// Blocks this account from a manual G/L journal line — it's a subledger control account
  /// (Bank, savings liability, loan receivable) and must be posted through its subledger
  /// instead. Enforced only at the manual-journal entry point; postJournal() itself still
  /// posts to these accounts freely for savings/loan/charge postings. See lib/gl.ts.
  no_direct_posting                                              Int                         @default(0)
  vat_bus_posting_group_code                                     String?
  vat_prod_posting_group_code                                    String?
  vat_posting_setup                                              vat_posting_setup[]
  journal_line                                                   journal_line[]
  bank_account                                                   bank_account?
  loan_product_loan_product_gl_interest_income_idTogl_account    loan_product[]              @relation("loan_product_gl_interest_income_idTogl_account")
  loan_product_loan_product_gl_penalty_income_idTogl_account     loan_product[]              @relation("loan_product_gl_penalty_income_idTogl_account")
  loan_product_loan_product_gl_receivable_idTogl_account         loan_product[]              @relation("loan_product_gl_receivable_idTogl_account")
  savings_product_savings_product_gl_control_idTogl_account      savings_product[]           @relation("savings_product_gl_control_idTogl_account")
  savings_product_savings_product_gl_fee_income_idTogl_account   savings_product[]           @relation("savings_product_gl_fee_income_idTogl_account")
  savings_product_savings_product_gl_interest_exp_idTogl_account savings_product[]           @relation("savings_product_gl_interest_exp_idTogl_account")
  member_category                                                member_category[]
  transaction_charge_setup                                       transaction_charge_setup[]
  loan_product_charge                                            loan_product_charge[]
  member_fixed_deposit_type_interest_expense                     member_fixed_deposit_type[] @relation("mfdt_interest_expense")
  member_fixed_deposit_type_interest_payable                     member_fixed_deposit_type[] @relation("mfdt_interest_payable")
  member_fixed_deposit_type_withholding_tax                      member_fixed_deposit_type[] @relation("mfdt_withholding_tax")
  cheque_type                                                    cheque_type[]
  cheque_deposit                                                 cheque_deposit[]            @relation("cd_clearing_gl_account")
  inventory_posting_group                                        inventory_posting_group[]   @relation("ipg_inventory_gl")
  product_posting_group                                          product_posting_group[]     @relation("ppg_adjustment_gl")
  fa_posting_group_acquisition_cost                              fa_posting_group[]          @relation("fapg_acquisition_cost")
  fa_posting_group_accum_depreciation                            fa_posting_group[]          @relation("fapg_accum_depreciation")
  fa_posting_group_depreciation_expense                          fa_posting_group[]          @relation("fapg_depreciation_expense")
  fa_posting_group_write_down_expense                            fa_posting_group[]          @relation("fapg_write_down_expense")
  fa_posting_group_appreciation                                  fa_posting_group[]          @relation("fapg_appreciation")
  fa_posting_group_maintenance_expense                           fa_posting_group[]          @relation("fapg_maintenance_expense")
  fa_posting_group_gains_on_disposal                             fa_posting_group[]          @relation("fapg_gains_on_disposal")
  fa_posting_group_losses_on_disposal                            fa_posting_group[]          @relation("fapg_losses_on_disposal")
  fa_journal_line                                                fa_journal_line[]
  customer_posting_group_receivables                             customer_posting_group[]    @relation("cpg_receivables")
  customer_posting_group_service_charge                          customer_posting_group[]    @relation("cpg_service_charge")
  customer_posting_group_additional_fee                          customer_posting_group[]    @relation("cpg_additional_fee")
  customer_posting_group_pmt_disc_debit                          customer_posting_group[]    @relation("cpg_pmt_disc_debit")
  customer_posting_group_pmt_disc_credit                         customer_posting_group[]    @relation("cpg_pmt_disc_credit")
  customer_posting_group_invoice_rounding                        customer_posting_group[]    @relation("cpg_invoice_rounding")
  product_posting_group_sales                                    product_posting_group[]     @relation("ppg_sales_gl")
  product_posting_group_cogs                                     product_posting_group[]     @relation("ppg_cogs_gl")
  vendor_posting_group_payables                                  vendor_posting_group[]      @relation("vpg_payables")
  vendor_posting_group_service_charge                            vendor_posting_group[]      @relation("vpg_service_charge")
  vendor_posting_group_pmt_disc_debit                            vendor_posting_group[]      @relation("vpg_pmt_disc_debit")
  vendor_posting_group_pmt_disc_credit                           vendor_posting_group[]      @relation("vpg_pmt_disc_credit")
  vendor_posting_group_invoice_rounding                          vendor_posting_group[]      @relation("vpg_invoice_rounding")
  currency_realized_gains                                        currency[]                  @relation("currency_realized_gains")
  currency_realized_losses                                       currency[]                  @relation("currency_realized_losses")
  currency_unrealized_gains                                      currency[]                  @relation("currency_unrealized_gains")
  currency_unrealized_losses                                     currency[]                  @relation("currency_unrealized_losses")
  currency_residual_gains                                        currency[]                  @relation("currency_residual_gains")
  currency_residual_losses                                       currency[]                  @relation("currency_residual_losses")
  bank_acc_posting_group                                         bank_acc_posting_group[]
  bank_rec_line                                                  bank_rec_line[]
  cash_management_setup_bank_charges                             cash_management_setup[]     @relation("cms_bank_charges")
  cash_management_setup_bank_interest                            cash_management_setup[]     @relation("cms_bank_interest")
