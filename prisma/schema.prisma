model role {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique
  description         String?
  is_system           Int                   @default(0)
  app_user            app_user[]
  permission_set_line permission_set_line[]
}

/**
 * One line of a Business Central-style Permission Set: a grant of rights on
 * one Object, which is either a database Table (Read/Insert/Modify/Delete)
 * or an application Page (Execute). A role with is_system=1 (System
 * Administrator) has no lines at all — full access is implied directly by
 * the flag, not by a wildcard row here.
 */
model permission_set_line {
  id           Int    @id @default(autoincrement())
  role_id      Int
  object_type  String // 'TABLE' | 'PAGE'
  object_name  String // table name (e.g. 'loan') or page code (e.g. 'LOANS')
  read_perm    Int    @default(0)
  insert_perm  Int    @default(0)
  modify_perm  Int    @default(0)
  delete_perm  Int    @default(0)
  execute_perm Int    @default(0)
  role         role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, object_type, object_name])
  @@index([role_id])
}

model savings_account {
  id                               Int                            @id @default(autoincrement())
  account_no                       String                         @unique
  member_id                        Int
  product_id                       Int
  balance                          BigInt                         @default(0)
  hold_amount                      BigInt                         @default(0)
  status                           String                         @default("ACTIVE")
  opened_date                      String?
  last_activity                    String?
  version                          Int                            @default(0)
  business_name                    String?
  business_location                String?
  business_paybill_till_no         String?
  business_phone_no                String?
  junior_name                      String?
  junior_birth_cert_no             String?                        @unique @db.VarChar(50)
  junior_date_of_birth             String?
  junior_photo                     String?
  loan                             loan[]
  member                           member                         @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savings_product                  savings_product                @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  txn                              txn[]
