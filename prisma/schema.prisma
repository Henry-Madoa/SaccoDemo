  description String            @default("")
  /// "Default Nos." — the series is offered automatically on a new document.
  default_nos Int               @default(1)
  /// "Manual Nos." — a user may also type a number by hand.
  manual_nos  Int               @default(0)
  /// "Date Order" — numbers must be assigned in non-decreasing document-date order.
  date_order  Int               @default(0)
  lines       no_series_line[]
  setups      no_series_setup[]
