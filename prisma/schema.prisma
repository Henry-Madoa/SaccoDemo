  relationship       String?
  phone              String?
  identification_no  String?
  percentage         Float              @default(0)
  is_next_of_kin     Int                @default(0)
  member_application member_application @relation(fields: [application_no], references: [no], onDelete: NoAction, onUpdate: NoAction)

  @@index([application_no], map: "ix_app_nominee_no")
}

/// Signatories for a non-individual (group/corporate) applicant — the office bearers
